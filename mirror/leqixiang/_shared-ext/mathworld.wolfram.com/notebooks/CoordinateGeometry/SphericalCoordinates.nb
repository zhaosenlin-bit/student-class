Cell[CellGroupData[{

Cell["Properties", "Section", ExpressionUUID->"b251c70f-2edf-4105-8962-65629c3ea3ea"],

Cell["\<\
These examples use the built-in chart order {Rr, Ttheta, Pphi}, with Ttheta \
the polar angle and Pphi the azimuth. F1, F2, and F3 denote components in the \
corresponding orthonormal spherical basis.\
\>", "Text", ExpressionUUID->"ddf69446-f1a8-499f-b53a-52b351a1fbca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coord", "=", "\"\<Spherical\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chartVars", "=", 
   RowBox[{"{", 
    RowBox[{"Rr", ",", "Ttheta", ",", "Pphi"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input", \
ExpressionUUID->"3cf1a708-7226-4f90-bef1-b73d056172a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoordinateChartData", "[", 
  RowBox[{
  "coord", ",", "\"\<CoordinateRangeAssumptions\>\"", ",", "chartVars"}], 
  "]"}]], "Input", ExpressionUUID->"e27ace9f-c6a8-4e56-9a50-eac8137a8814"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rr", ">", "0"}], "&&", 
  RowBox[{"0", "<", "Ttheta", "<", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"-", "\[Pi]"}], "<", "Pphi", "\[LessEqual]", "\[Pi]"}]}]], "Output",\
 ExpressionUUID->"b0c8b834-9927-4c4b-a106-7335437c4aa9"]
}, Open  ]],


Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{"\[Integral]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "x"}], "+", "1"}], ")"}], " ", 
       RowBox[{"exp", "(", "x", ")"}]}], "+", "1"}], 
     RowBox[{"2", " ", 
      SqrtBox[
       RowBox[{
        RowBox[{"exp", "(", 
         RowBox[{"-", "x"}], ")"}], "+", "x"}]]}]], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]], "Subsection", \
ExpressionUUID->"744355af-67df-4ef8-9ae0-f24fca0e223c"],

Cell["\<\
Desmond, H.  ``Exhaustive Symbolic Integration: Integration by \
Differentiation and the Landscape of Symbolic Integrability.''  6 May 2026.  \
https://arxiv.org/abs/2605.04978\
\>", "Text", ExpressionUUID->"774b2efd-6360-4319-b330-c1cee2c9f96e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "x"}], "+", "1"}], ")"}], " ", 
       RowBox[{"Exp", "[", "x", "]"}]}], "+", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"x", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "x"}], "]"}]}], "]"}]}], ")"}]}], ",", "x"}], 
  "]"}]], "Input", ExpressionUUID->"b1fb4b56-9bbd-460f-91fa-40be6117f2ad"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"\[Integral]", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "x"}]}], ")"}]}]}], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", "x"}]], "+", "x"}]]], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Output",
 CellLabel->"Out[3]=", ExpressionUUID->"9aea259d-203a-4387-be48-f5fa9bedbe82"]
}, Open  ]],


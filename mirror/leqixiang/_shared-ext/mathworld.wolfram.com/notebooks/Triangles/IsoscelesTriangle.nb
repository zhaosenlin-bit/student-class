Cell[CellGroupData[{

Cell["Erecting Isosceles Triangles on Arbitrary Triangle", "Section",ExpressionUUID->"0fda4a85-6848-44ba-9b13-ed6697ab2540"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tri", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".4", ",", ".7"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".012", "]"}], ",", 
          RowBox[{"Triangle", "[", "tri", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0", ",", "1"}], "]"}], ",", 
        RowBox[{"e", "=", 
         RowBox[{"ErectScaleneTriangles", "[", 
          RowBox[{"tri", ",", ".5"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Line", "/@", 
         RowBox[{"(", 
          RowBox[{"l", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"v", "=", 
               RowBox[{"Last", "@@@", "e"}]}], ",", "tri"}], "}"}], "]"}]}], 
          ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PointSize", "[", ".03", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"LineLineIntersection", "@@", 
          RowBox[{"Take", "[", 
           RowBox[{"l", ",", "2"}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0", ",", "1"}], "]"}], ",", 
        RowBox[{"PointLabels", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"v", ",", 
               RowBox[{"{", 
                RowBox[{"\"\<A'\>\"", ",", "\"\<B'\>\"", ",", "\"\<C'\>\""}], 
                "}"}]}], "}"}], "]"}], ",", "1"}], "]"}], ",", ".03", ",", 
          ".04"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".02", ",", ".02"}], "}"}], "]"}], ",", 
        RowBox[{"Triangle", "[", "v", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PointLabels", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"tri", ",", 
               RowBox[{"{", 
                RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
                "}"}]}], "}"}], "]"}], ",", "1"}], "]"}], ",", ".03", ",", 
          ".04"}], "]"}]}], "\[IndentingNewLine]", "}"}], "/.", 
      RowBox[{"Triangle", "\[RuleDelayed]", "polygon"}]}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",ExpressionUUID->\

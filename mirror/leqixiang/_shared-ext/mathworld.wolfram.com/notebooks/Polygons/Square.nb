Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "x", "]"}], ",", 
     RowBox[{"Abs", "[", "y", "]"}]}], "]"}], "\[LessEqual]", 
   RowBox[{"a", "/", "2"}]}]}]], "Input",ExpressionUUID->"43af1d9f-b376-4ac1-\
a265-255caf15d310"],


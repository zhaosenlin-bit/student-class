Cell[CellGroupData[{

Cell["Diagram", "Section",ExpressionUUID->"e92ec673-f2fb-423b-ac33-3783ec73ec79"],

Cell[CellGroupData[{

Cell["V5", "Subsubsection",ExpressionUUID->"43a571f7-6505-4b22-a734-a237e2b1915f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircumcircleDiagram", "[", "v_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tri", "=", 
      RowBox[{"Triangle", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vert", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Vertices", "[", "tri", "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"foot", "[", "i_", "]"}], ":=", 
      RowBox[{"Foot", "[", 
       RowBox[{
        RowBox[{"PerpendicularBisectors", "[", "tri", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "TarryPoint", ",", "\"\<T\>\"", ",", "SteinerPoint", ",", "\"\<S\>\"", 
        ",", "\[IndentingNewLine]", "Circumcenter", ",", "\"\<O\>\"", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"vert", "[", "1", "]"}], ",", "\"\<A\>\"", ",", 
        RowBox[{"vert", "[", "2", "]"}], ",", "\"\<B\>\"", ",", 
        RowBox[{"vert", "[", "3", "]"}], ",", "\"\<C\>\""}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"redpts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"foot", "[", "1", "]"}], ",", 
        "\"\<\!\(\*SubscriptBox[\(M\), \(A\)]\)\>\"", ",", 
        RowBox[{"foot", "[", "2", "]"}], ",", 
        "\"\<\!\(\*SubscriptBox[\(M\), \(B\)]\)\>\"", ",", 
        RowBox[{"foot", "[", "3", "]"}], ",", 
        "\"\<\!\(\*SubscriptBox[\(M\), \(C\)]\)\>\""}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ClosedLine", "[", "v", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"EqualSideTicksAboutMidpoints", "[", 
        RowBox[{"tri", ",", ".05"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Circumcircle", "[", "tri", "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Red", ",", "\[IndentingNewLine]", 
         RowBox[{"PerpendicularBisectors", "[", "tri", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PointLabels", "[", 
          RowBox[{"tri", ",", "redpts", ",", ".03"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"PerpSquare", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"PerpendicularLine", "[", 
                RowBox[{
                 RowBox[{"Circumcenter", "[", "tri", "]"}], ",", "#"}], 
                "]"}]}], "}"}], ",", ".08", ",", "3"}], "]"}], "&"}], "/@", 
          RowBox[{"Sides", "[", "tri", "]"}]}]}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Green", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"Coordinates", "/@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TarryPoint", "[", "tri", "]"}], ",", 
             RowBox[{"SteinerPoint", "[", "tri", "]"}]}], "}"}]}], "]"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Coordinates", "@", 
               RowBox[{"Circumcenter", "[", "tri", "]"}]}], ",", "#"}], "}"}],
             "]"}], "&"}], "/@", 
          RowBox[{"Vertices", "[", "tri", "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PointLabels", "[", 
        RowBox[{"tri", ",", "pts", ",", ".03"}], "]"}]}], 
      "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",ExpressionUUID->"ba0e636b-23d2-4a80-811e-e8d2fda8cb86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"CircumcircleDiagram", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.", ",", 
         RowBox[{"-", ".5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1.3", ",", "1.7"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3.", ",", 
         RowBox[{"-", ".4"}]}], "}"}]}], "}"}], "]"}], "]"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]], "Input",Expressi\
onUUID->"feba7b86-d93f-427e-af07-5c66813837ed"],


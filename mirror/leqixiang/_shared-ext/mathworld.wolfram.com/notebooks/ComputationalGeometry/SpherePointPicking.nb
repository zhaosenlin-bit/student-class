Cell[CellGroupData[{

Cell["Marsaglia Method", "Section"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Marsaglia", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Random", "[", 
           RowBox[{"Real", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "n", "}"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ".", "#"}], "<=", "1"}], "&"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "#1", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#1", "^", "2"}], "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", 
        RowBox[{"2", "#2", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#1", "^", "2"}], "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", 
        RowBox[{"1", "-", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "^", "2"}], "+", 
            RowBox[{"#2", "^", "2"}]}], ")"}]}]}]}], "}"}], "&"}], "@@@", 
     "pts"}]}], "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SpherePlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Point", "/@", 
        RowBox[{"Marsaglia", "[", "#", "]"}]}], "&"}], ")"}], "/@", 
     RowBox[{"{", 
      RowBox[{"100", ",", "1000", ",", "5000"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1.3", ",", 
        RowBox[{"-", "2.4"}], ",", "2."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "2"}], "}"}]}], "}"}]}], "]"}], "//", 
  "Timing"}]], "Input"],


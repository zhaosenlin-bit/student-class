Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"\[Xi]_", ",", "\[Eta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"a", " ", 
    RowBox[{"Sin", "[", "\[Xi]", "]"}], 
    RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
   RowBox[{
    RowBox[{"Cosh", "[", "\[Eta]", "]"}], "-", 
    RowBox[{"Cos", "[", "\[Xi]", "]"}]}]]}], "\n", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"\[Xi]_", ",", "\[Eta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"a", " ", 
    RowBox[{"Sin", "[", "\[Xi]", "]"}], 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
   RowBox[{
    RowBox[{"Cosh", "[", "\[Eta]", "]"}], "-", 
    RowBox[{"Cos", "[", "\[Xi]", "]"}]}]]}], "\n", 
 RowBox[{
  RowBox[{"z", "[", 
   RowBox[{"\[Xi]_", ",", "\[Eta]_", ",", "\[Phi]_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"a", " ", 
    RowBox[{"Sinh", "[", "\[Eta]", "]"}]}], 
   RowBox[{
    RowBox[{"Cosh", "[", "\[Eta]", "]"}], "-", 
    RowBox[{"Cos", "[", "\[Xi]", "]"}]}]]}]}], "Input"]
}, Open  ]],


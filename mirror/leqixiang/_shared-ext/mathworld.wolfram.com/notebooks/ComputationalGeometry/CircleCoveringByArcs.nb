Cell["Probability of Complete Coverage", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"k", "=", "0"}], 
    TemplateBox[{RowBox[{"1", "/", "a"}]},
     "Floor"]], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "k"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"a", " ", "k"}]}], ")"}], 
     RowBox[{"n", "-", "1"}]], " ", 
    TemplateBox[{"n","k"},
     "Binomial"]}]}], TraditionalForm]], "Subsection"],

Cell[CellGroupData[{

Cell["V5", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", "k"}], " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", "k"}], "]"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"k", " ", "a"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", 
     RowBox[{"Floor", "[", 
      RowBox[{"1", "/", "a"}], "]"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  UnderoverscriptBox["\[Sum]", 
   RowBox[{"k", "=", "0"}], 
   RowBox[{"Floor", "[", 
    FractionBox["1", "a"], "]"}]], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "k"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"a", " ", "k"}]}], ")"}], 
    RowBox[{
     RowBox[{"-", "1"}], "+", "n"}]], " ", 
   RowBox[{"Binomial", "[", 
    RowBox[{"n", ",", "k"}], "]"}]}]}]], "Output"]
}, Open  ]]
}, Closed]],


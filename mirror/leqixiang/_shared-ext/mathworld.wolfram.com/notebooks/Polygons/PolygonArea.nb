      RowBox[{
       RowBox[{"x", "[", "i_", "]"}], ":=", 
       RowBox[{"X", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", "n"}], "]"}], "+", "1"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "i_", "]"}], ":=", 
       RowBox[{"Y", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", "n"}], "]"}], "+", "1"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], "+", 
              RowBox[{"x", "[", 
               RowBox[{"i", "+", "1"}], "]"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"x", "[", "i", "]"}], 

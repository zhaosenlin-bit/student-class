Cell["Area of a Random Triangle", "Section",ExpressionUUID->"f4b1a191-97d5-4504-8ef0-9a45e13d362b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronVolume", "[", 
   RowBox[{"{", 
    RowBox[{"x1_", ",", "x2_", ",", "x3_", ",", "x4_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], "]"}], ",", 
        
        RowBox[{"{", "i", "}"}]}], "]"}], "]"}], "/", 
     RowBox[{"3", "!"}]}]}], "]"}]}]], "Input",ExpressionUUID->"b5561937-e960-\
4e3c-8bf4-7c26054a8b29"],


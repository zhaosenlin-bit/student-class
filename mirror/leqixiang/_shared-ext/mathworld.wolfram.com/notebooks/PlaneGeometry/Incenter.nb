         RowBox[{
          RowBox[{"(", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"pt", "=", 
             RowBox[{"Switch", "[", 
              RowBox[{"rc", ",", "\[IndentingNewLine]", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"#", "==", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "&"}], 
                 ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Or", "@@", 
                 RowBox[{"Thread", "[", 
                  RowBox[{"#", "\[Equal]", "0"}], "]"}]}], "&"}], ",", 
               RowBox[{
                RowBox[{"Message", "[", 
                 RowBox[{
                  RowBox[{"search", ":", "zero"}], ",", "#"}], "]"}], ";", 
                "rc"}], ",", "\[IndentingNewLine]", "_", ",", 
               RowBox[{
                RowBox[{"Rest", "[", "rc", "]"}], "/", 
                RowBox[{"First", "[", "rc", "]"}]}]}], "\[IndentingNewLine]", 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"pt", "\[Equal]", 
               RowBox[{"{", 

Cell[CellGroupData[{

Cell["Examples", "Section",ExpressionUUID->"fcc7663f-3371-4c95-a271-65b7e8a81b60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"laminae", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"EntityList", "[", 
     RowBox[{"EntityClass", "[", 
      RowBox[{"\"\<Lamina\>\"", ",", "\"\<Polygon\>\""}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<VertexCount\>\"", "]"}], "\[Equal]", "6"}], 
     "&"}]}], "]"}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"e6f33f89-18cd-4521-9008-c08087e22add"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"\"regular hexagon\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"FilledRegularHexagon\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"FilledRegularHexagon\\\"]\"","\"lamina\""},
    
    "Entity"], ",", 
   TemplateBox[{"\"rectangular L\[Hyphen]beam\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"RectangularLBeam\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"RectangularLBeam\\\"]\"","\"lamina\""},
    "Entity"], ",", 
   TemplateBox[{"\"square L\[Hyphen]beam\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"SquareLBeam\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"SquareLBeam\\\"]\"","\"lamina\""},
    "Entity"]}], "}"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"855ca0ac-d7f9-4df8-a350-e1e4fb28572a"]
}, Open  ]],


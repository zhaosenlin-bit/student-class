Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Bipolar*"}]], "Input"],

Cell[BoxData[
 RowBox[{"\<\"Bipolar represents the bipolar coordinate system with default \
variables Uu, Vv, and Zz and default parameter value 1. Bipolar[u, v, z] \
represents the bipolar coordinate system with variables u, v, and z and \
default parameter value 1. Bipolar[u, v, z, a] represents the bipolar \
coordinate system with variables u, v, and z, and parameter a.\"\>", " ", 
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"AddOnsLink",
   ButtonData:>"Calculus`VectorAnalysis`"]}]], "Print",
 CellTags->"Info3292611988-2168499"]
}, Open  ]]

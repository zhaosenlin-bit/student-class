Cell[CellGroupData[{

Cell["Inequality", "Subsection",ExpressionUUID->"880f5a44-ff46-4128-b4ba-4d54c0cc5b41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "a"}], "/", "2"}], "\[LessEqual]", "x", "\[LessEqual]", 
    RowBox[{"a", "/", "2"}]}], "&&", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "b"}], "/", "2"}], "\[LessEqual]", "y", "\[LessEqual]", 
    RowBox[{"b", "/", "2"}]}]}]}]], "Input",ExpressionUUID->"21ed5f0b-f33b-\
4791-8a03-1e3f8ce964c5"],

Cell[CellGroupData[{


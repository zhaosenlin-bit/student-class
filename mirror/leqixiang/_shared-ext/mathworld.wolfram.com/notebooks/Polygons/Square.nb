Cell[CellGroupData[{

Cell["Inscribed Square", "Section",ExpressionUUID->"d6e76188-f3e2-46b7-909a-7a1929ef3dc5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], 
      RowBox[{"Through", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Sin", ",", "Cos"}], "}"}], "[", 
        RowBox[{"Pi", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "+", 
            RowBox[{"1", "/", "2"}]}], ")"}], "/", "2"}]}], "]"}], "]"}]}], 
     "&"}], "/@", 
    RowBox[{"Range", "[", "4", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "#", "]"}], "-", 
      RowBox[{".3", 
       RowBox[{"Subtract", "@@", "#"}]}]}], "&"}], "/@", 
    RowBox[{"Partition", "[", 
     RowBox[{"v", ",", "2", ",", "1", ",", "1"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lines", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RotateRight", "[", "v", "]"}], ",", "v2"}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ineqs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "1"}], "}"}], ",", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], ",", "1"}], "]"}], ",", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], ",", "1"}], "]"}]}], "}"}], "]"}],
       "<", "0"}], "&"}], "/@", "lines"}]}], ";"}]}], "Input",ExpressionUUID->\
"793f1f18-a8b6-4f42-bb54-8b630f0f0e62"],

Cell[BoxData[{
 RowBox[{"<<", "Graphics`InequalityGraphics`"}], "\n", 
 RowBox[{"<<", "Graphics`Colors`"}]}], "Input",ExpressionUUID->"e93e05d2-2b12-\
48ee-a8b3-ede63fac07c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"GraphicsArray", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ClosedLine", "[", "v", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"InequalityPlot", "[", 
           RowBox[{
            RowBox[{"And", "@@", "ineqs"}], ",", 
            RowBox[{"{", "x", "}"}], ",", 
            RowBox[{"{", "y", "}"}], ",", 
            RowBox[{"DisplayFunction", "\[Rule]", "Identity"}], ",", 
            RowBox[{"Fills", "\[Rule]", "Yellow"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Line", "/@", "lines"}]}], "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ClosedLine", "[", "v", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Line", "/@", "lines"}]}], "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}], "}"}], 
   "\[IndentingNewLine]", "]"}], "]"}]], "Input",ExpressionUUID->"d1034b96-\
1bf5-4bba-8dec-b872ebac6f33"],


 RowBox[{"<<", "ConvexHull`"}]], "Input",ExpressionUUID->"6717b751-050a-44b8-9921-8215dbc7bb54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"GraphicsArray", "[", 
    RowBox[{"Partition", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}], "&"}], "/@", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"v", ",", 
          RowBox[{"ConvexHull3D", "[", 
           RowBox[{"Union", "[", 
            RowBox[{"Chop", "/@", 
             RowBox[{"Simplify", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", ".", "v"}], "&"}], "/@", 
               RowBox[{"PointGroup", "[", "\"\<O\>\"", "]"}]}], "]"}]}], 
            "]"}], "]"}]}], "]"}], "/@", 
        RowBox[{"(", 
         RowBox[{"N", "/@", 
          RowBox[{"Vector", "/@", "polys"}]}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", "4", ",", "4", ",", 

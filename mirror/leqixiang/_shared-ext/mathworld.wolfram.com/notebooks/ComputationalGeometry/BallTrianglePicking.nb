          RowBox[{
           RowBox[{"6", "m"}], "+", "1"}], ",", 
          RowBox[{"2", "m"}]}], "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"n_Integer", "?", "EvenQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "-", "2"}], ")"}], "/", "2"}]}], ",", "k"}], "}"}], ",",

Cell[CellGroupData[{

Cell["Triangle Midpoint Equidistance Offset Theorem", "Section",ExpressionUUID->"7eccd21b-7fa2-4b3e-ac2e-701be0cbf9aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".2", ",", ".7"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"{", 
    RowBox[{".08", ",", ".1", ",", ".12"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tp", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{
     RowBox[{"Coordinates", "/@", 
      RowBox[{"Midpoints", "[", "t", "]"}]}], "+", 
     RowBox[{"v", " ", 
      RowBox[{"SideUnitVectors", "[", "t", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tq", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{
     RowBox[{"Coordinates", "/@", 
      RowBox[{"Midpoints", "[", "t", "]"}]}], "-", 
     RowBox[{"v", " ", 
      RowBox[{"SideUnitVectors", "[", "t", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"t", ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "tp"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "tq"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexPoints", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(A\), \(1\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(A\), \(2\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(A\), \(3\)]\)\>\""}], "}"}]}], "}"}],
            "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Midpoints", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(M\), \(1\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(M\), \(2\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(M\), \(3\)]\)\>\""}], "}"}]}], "}"}],
            "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "Red"}], "]"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"VertexPoints", "[", "tp", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(P\), \(3\)]\)\>\""}], "}"}]}], 
             "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "Blue"}], "]"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"VertexPoints", "[", "tq", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{

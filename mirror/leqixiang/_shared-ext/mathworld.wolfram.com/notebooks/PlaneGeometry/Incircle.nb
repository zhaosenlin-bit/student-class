                  RowBox[{"i", ",", "2"}], "]"}], "+", 
                 RowBox[{"t", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "1"}], ",", "1"}], "]"}]}], "==", "Pi"}],
                ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
           "1"}], "]"}], "]"}], ",", "\n", "\t\t", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"(", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"vars", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"s", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "//", "Flatten"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"4", "n"}]}], "}"}]}], "]"}], ")"}]}], "]"}], ",", 
        "\n", "\t\t", 
        RowBox[{"MaxIterations", "->", "5000"}], ",", 
        RowBox[{"DampingFactor", "->", "2"}]}], "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"Print", "[", "soln", "]"}], ";", "\n", "\t", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\n", "\t\t\t\t\t", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"dd", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"xh", ",", "h"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", "\n", 
           "\t\t\t\t\t", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"xh", ",", "h"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"d", "[", "i", "]"}], ",", "0"}], "}"}]}], "}"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", "\n", 
           "\t\t\t\t\t", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Circle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"i", "-", "1"}], "]"}], "+", 
                  RowBox[{"x", "[", "i", "]"}]}], ",", "a"}], "}"}], ",", 
               "a"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "\n", "\t\t\t\t\t", 
          "}"}], " ", "/.", " ", "soln"}], "]"}], ",", 
       RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}]}], "\n", 
   "]"}]}]], "Input",ExpressionUUID->"cd493f55-726a-4564-adf5-3ddda4cc47ef"]

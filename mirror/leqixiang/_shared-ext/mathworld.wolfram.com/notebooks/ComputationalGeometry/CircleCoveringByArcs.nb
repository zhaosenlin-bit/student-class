       RowBox[{"1", "-", 
        RowBox[{"a", " ", "j"}]}], ")"}], 
      RowBox[{"n", "-", "1"}]], " ", 
     TemplateBox[{RowBox[{"n", "-", "l"}],RowBox[{"j", "-", "l"}]},
      "Binomial"]}]}]}], TraditionalForm]], "Subsection"],


Cell[CellGroupData[{

Cell["Initialization", "Subsection",ExpressionUUID->"89a4ccf1-d7b1-4030-b69c-73bb724b2b8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"Cosh", "[", "u", "]"}], 
      RowBox[{"Cos", "[", "v", "]"}]}], ",", 
     RowBox[{"a", " ", 
      RowBox[{"Sinh", "[", "u", "]"}], 
      RowBox[{"Sin", "[", "v", "]"}]}], ",", "z"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"u", ",", "v", ",", "z"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ranges", "=", 
   RowBox[{
    RowBox[{"u", "\[GreaterEqual]", "0"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "v", "<", 
     RowBox[{"2", "\[Pi]"}]}], "&&", 
    RowBox[{"a", ">", "0"}]}]}], ";"}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"6fe894f7-88f9-43b9-9924-099aaf1ceba5"]
}, Open  ]],


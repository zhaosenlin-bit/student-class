Cell[CellGroupData[{

Cell["Top Vertex Position in Terms of Sides", "Section", ExpressionUUID->"993ebc6d-ff4b-4603-9703-d1810bf9369f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"soln", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], "/.", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], "\[Equal]", 
         RowBox[{"b", "^", "2"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "c"}], ")"}], "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], "\[Equal]", 
         RowBox[{"a", "^", "2"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}]], "Input", \
ExpressionUUID->"c784bc8f-b825-4b25-aad3-5319bc2d2563"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["a", "2"]}], "+", 
       SuperscriptBox["b", "2"], "+", 
       SuperscriptBox["c", "2"]}], 
      RowBox[{"2", " ", "c"}]], ",", 
     RowBox[{"-", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["b", "2"], "-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 

Cell[CellGroupData[{

Cell["Area of a Random Triangle", "Section",ExpressionUUID->"45f99a29-efdc-4ccb-a347-e845bb8e3635"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleArea3D", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", "y1_", ",", "z1_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2_", ",", "y2_", ",", "z2_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x3_", ",", "y3_", ",", "z3_"}], "}"}]}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "x2"}], "*", "y1"}], "+", 
        RowBox[{"x3", "*", "y1"}], "+", 
        RowBox[{"x1", "*", "y2"}], "-", 
        RowBox[{"x3", "*", "y2"}], "-", 
        RowBox[{"x1", "*", "y3"}], "+", 
        RowBox[{"x2", "*", "y3"}]}], ")"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x2", "*", "z1"}], "-", 
        RowBox[{"x3", "*", "z1"}], "-", 
        RowBox[{"x1", "*", "z2"}], "+", 
        RowBox[{"x3", "*", "z2"}], "+", 
        RowBox[{"x1", "*", "z3"}], "-", 
        RowBox[{"x2", "*", "z3"}]}], ")"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "y2"}], "*", "z1"}], "+", 
        RowBox[{"y3", "*", "z1"}], "+", 
        RowBox[{"y1", "*", "z2"}], "-", 
        RowBox[{"y3", "*", "z2"}], "-", 
        RowBox[{"y1", "*", "z3"}], "+", 
        RowBox[{"y2", "*", "z3"}]}], ")"}], "^", "2"}]}], "]"}], "/", 
   "2"}]}]], "Input",ExpressionUUID->"909abbf3-3f42-4893-a1b8-5cdca61267bd"],


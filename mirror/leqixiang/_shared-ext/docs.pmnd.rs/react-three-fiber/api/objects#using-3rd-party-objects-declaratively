</span><span class="code-line">    ref<span class="token punctuation">.</span><span class="token property-access">current</span><span class="token punctuation">.</span><span class="token property-access">uniforms</span><span class="token punctuation">.</span><span class="token property-access">time</span><span class="token punctuation">.</span><span class="token property-access">value</span> <span class="token operator">=</span> clock<span class="token punctuation">.</span><span class="token property-access">elapsedTime</span>

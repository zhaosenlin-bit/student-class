Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".2", ",", ".7"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"t", ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"pedals", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Cartesian", "[", 
            RowBox[{"#", "[", "t", "]"}], "]"}], "&"}], "/@", 
          RowBox[{"PedalLines", "[", "Circumcenter", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"PerpSquare", "[", 
           RowBox[{"#", ",", ".03", ",", "1"}], "]"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sides", "[", "t", "]"}], ",", "pedals"}], "}"}], 
          "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Incircle", "[", "t", "]"}], ",", 
        RowBox[{"Circumcircle", "[", "t", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexPoints", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
              "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "Blue"}], "]"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Cartesian", "[", 
                 RowBox[{"#", "[", "t", "]"}], "]"}], "&"}], "/@", 
               RowBox[{"Vertices", "[", 
                RowBox[{"PedalTriangle", "[", "Circumcenter", "]"}], "]"}]}], 
              ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<\!\(\*SubscriptBox[\(O\), \(A\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(O\), \(B\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(O\), \(C\)]\)\>\""}], "}"}], ",", 
              RowBox[{"Thread", "[", 
               RowBox[{"LabelOffset", "\[Rule]", 
                RowBox[{".04", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1.2"}], ",", ".05"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "]"}]}], "}"}], 
            "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Circumcenter", "[", "t", "]"}], ",", "\"\<O\>\"", ",", 
              "Red"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Incenter", "[", "t", "]"}], ",", "\"\<I\>\"", ",", 
              "Red"}], "}"}]}], "\[IndentingNewLine]", "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"LabelOffset", "\[Rule]", ".03"}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",ExpressionUUID-\
>"389d423e-bed8-4aeb-a118-32a9b3d60d46"],


Notebook[{Cell[CellGroupData[{Cell["Congruent Triangles", "Title", 
      ExpressionUUID -> "b5402523-b2b0-4844-b8dd-65ca706e76aa"], 
     Cell[CellGroupData[{Cell["Author", "Subsection", ExpressionUUID -> 
          "099a1820-76c4-40b6-ac8d-138bbe75b621"], 
        Cell["Eric W. Weisstein\nAugust 12, 2026", "Text", 
         ExpressionUUID -> "6f166cdc-6d5b-43f7-b046-1541ec8639c7"], 
        Cell["This notebook downloaded from https://mathworld.wolfram.com/notebooks/Triangles/CongruentTriangles.nb."\
, "Text", ExpressionUUID -> "59f93118-bb04-44df-9d59-d1d77ba99660"], 
        Cell["For more information, see Eric's MathWorld entry \
https://mathworld.wolfram.com/CongruentTriangles.html.", "Text", 
         ExpressionUUID -> "782295a4-7850-4878-9b4c-b420f45d24bf"], 
        Cell["\[Copyright]2026 Wolfram Research, Inc. except for portions \
noted otherwise", "Text", ExpressionUUID -> 
          "dc8e7606-386a-4df7-ac17-5ad2f45d7011"]}, Open]], 
     Cell[CellGroupData[{Cell["Illustration", "Section", 
         ExpressionUUID -> "ab349a93-71ef-4d32-b694-774b0dca9700"], 
        Cell["The second triangle is a rotated and translated copy of the \
first, and matching tick marks identify equal corresponding side lengths.", 
         "Text", ExpressionUUID -> "ff6f5968-ea78-41d7-b6b8-9252b3afa654"], 
        Cell[CellGroupData[{Cell["Module[{color, labelPositions, labels1, \
labels2, neutral, tickMarks, triangle1, \n   triangle2}, triangle1 = {{-2.4, \
-0.8}, {-0.2, -0.8}, {-1.55, 1.05}}; \n   triangle2 = \
(RotationTransform[-0.72, Mean[triangle1]][#1] + {3.3, 0.15} & ) /@ \
triangle1; \n   color = Blue; neutral = LightDarkSwitched[Black, White]; \
labelPositions[triangle_] := \n    (#1 + 0.2*Normalize[#1 - Mean[triangle]] & \
) /@ triangle; \n   tickMarks[p_, q_, n_] := Module[{midpoint, normal, \
tangent}, \n     midpoint = (p + q)/2; tangent = Normalize[q - p]; normal = \
{-tangent[[2]], tangent[[1]]}; \n      Table[Line[{midpoint + 0.13*(k - (n + \
1)/2)*tangent - 0.09*normal, \n         midpoint + 0.13*(k - (n + \
1)/2)*tangent + 0.09*normal}], {k, n}]]; \n   labels1 = {\"A\", \"B\", \
\"C\"}; labels2 = {\"A'\", \"B'\", \"C'\"}; \n   Graphics[{{Directive[color, \
Opacity[0.16]], Polygon[triangle1], Polygon[triangle2]}, \n     \
Directive[neutral, Opacity[1], AbsoluteThickness[2]], \n     \
Line[Append[triangle1, First[triangle1]]], Line[Append[triangle2, \
First[triangle2]]], \n     tickMarks[triangle1[[1]], triangle1[[2]], 1], \
tickMarks[triangle2[[1]], triangle2[[2]], 1], \n     \
tickMarks[triangle1[[2]], triangle1[[3]], 2], tickMarks[triangle2[[2]], \
triangle2[[3]], 2], \n     tickMarks[triangle1[[3]], triangle1[[1]], 3], \
tickMarks[triangle2[[3]], triangle2[[1]], 3], \n     MapThread[Text[Style[#1, \
16, neutral, FontFamily -> \"Times\", FontSlant -> \"Italic\"], #2] & , \n    \
  {labels1, labelPositions[triangle1]}], \n     MapThread[Text[Style[#1, 16, \
neutral, FontFamily -> \"Times\", FontSlant -> \"Italic\"], #2] & , \n      \
{labels2, labelPositions[triangle2]}]}]]", "Input", ExpressionUUID -> 
             "9fcc309e-9114-4b28-99ad-66f859d6b8db"], 

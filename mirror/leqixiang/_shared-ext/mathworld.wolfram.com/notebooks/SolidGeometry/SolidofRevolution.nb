Cell[CellGroupData[{

Cell["Code", "Subsection",ExpressionUUID->"4483f5b9-bc48-4894-8f4e-ada320fc03e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"VolumeByCylinders", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "g_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"2", "Pi", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "-", "g"}], ")"}], " ", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", "opts"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VolumeByCylinders", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
   RowBox[{"VolumeByCylinders", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", "opts"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VolumeByWashers", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "g_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z_", ",", "a_", ",", "b_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Pi", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "2"], "-", 
      SuperscriptBox["g", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "a", ",", "b"}], "}"}], ",", "opts"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VolumeByWashers", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"z_", ",", "a_", ",", "b_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"VolumeByWashers", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "a", ",", "b"}], "}"}], ",", "opts"}], 
   "]"}]}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"753a54a6-eaed-4fb2-96ca-ccc00e0baec8"]
}, Open  ]],


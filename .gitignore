# ---------------------------------------------------------------------
# What stays out of the repository.
#
# The project is the server, the tools and the mirrored library. The
# things below are either toolchains that a machine installs for itself,
# build output that can be produced again, or working files that belong
# to one run.
# ---------------------------------------------------------------------

# Toolchains and build output
tools/node24/
tools/mingw64/
tools/mingw-binutils/
tools/.cache/
craft-anything/target/
.cargo/

# Browser profiles used for crawling and for the verification runs
tools/chrome-*/

# The vendored upstream projects keep their own history, and it stays on
# this machine (C:\kaifa\_vendored-git-backup) instead of in the repo.
rea/.git/
rea-src/.git/
craft-anything/.git/

# The upstream tool sources are not part of the library.  They stay on
# this machine so the recon scripts keep working, but the repository is
# the courseware library and nothing else.
rea/
rea-src/
craft-anything/

# Upstream projects cloned to be mirrored. Only the mirrored output is
# tracked; the checkout with its own history stays on this machine.
recon/vendor/

# rea-src/ is a byte-for-byte copy of rea/. Only one of them is tracked.
rea-src/

# Working files of a single run
recon/captures/
recon/rust-hello/
# The upstream crawl evidence stays on the machine: it names the sites
# the material came from, and the repository does not need it.
recon/craft/
recon/craft-*
recon/scenarios/
recon/scenario-*.json
recon/*-urls.txt
recon/afe-guest-paths.json
recon/xb-live-method-matrix.json
recon/mk-scenario.js
recon/runtime-scripts.json
recon/response-body-diff.json
# Pictures and audio drawn by the generators while a work was being
# built. They are produced again by tools\make-*.mjs.
recon/art/
recon/scratch/*
# Scratch scripts written while chasing one question; they are replaced
# by a real tool under tools/ once the question is answered.
tools/_*.mjs
# The notes of a single run stay on the machine.  Only the receipts of
# the version that is being kept are in the repository, and they are
# named one by one below.
!recon/scratch/lq-all-after-build.json
!recon/scratch/lq-all-preview-download.json
!recon/scratch/lq-verify-all.json
!recon/scratch/lq-verify-changed.json
!recon/scratch/lq-verify-new25.json
!recon/scratch/lq-verify-ext.json
!recon/scratch/lq-quality-gate.json
!recon/scratch/lq-offline-report.json
!recon/scratch/phet-zh-audit.json

# The scripts that answered one question and were never needed again.
# The archive next to the project keeps a copy of every one of them.
tools/probes/
tools/probe-*
tools/debug-*
tools/dump-*
tools/show-*
tools/inspect-*
tools/compare-*
tools/count-*
tools/test-*
tools/deobfuscate-*
tools/afe-login*
tools/xb-login*
tools/seed-browser-login.mjs
tools/wait-afe-login.mjs
tools/write-afe-guest-paths.mjs
tools/restore-afe-prices.mjs
tools/sweep-trials.mjs
tools/make-entry-test.mjs

# Live captures quote the account that was signed in while they were
# taken, so they stay on the machine together with the tokens.
recon/scratch/live-*.json
recon/scratch/live-search-*.json
recon/scratch/reviewed-sessions.json

# Credentials that belong to one account, never to the repository
recon/scratch/*.txt
recon/scratch/*.cookie
recon/scratch/afe-user.json
*.token
*.cookie
.env
.env.*

# Editor and OS noise
.DS_Store
Thumbs.db
*.tmp
*.log
*.err
__pycache__/

# Node
node_modules/
npm-debug.log*

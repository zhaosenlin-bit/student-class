Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", 
    RowBox[{"n_Integer", "?", "OddQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}], "/", "2"}]}], ",", "k"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"2", "m"}], ",", "m"}], "]"}], "^", "2"}], " ", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"2", "m"}], ")"}]}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"2", "k"}], ",", "k"}], "]"}], 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"3", "m"}], "+", "k", "+", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"m", "+", "k"}], ")"}]}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"4", "m"}], "+", 
               RowBox[{"2", "k"}], "+", "1"}], ")"}]}], "/", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"2", "m"}], "+", "k"}], ",", "m"}], "]"}]}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"4", "m"}], "+", 
              RowBox[{"2", "k"}]}], ",", 
             RowBox[{
              RowBox[{"2", "m"}], "+", "k"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "m"}], "}"}]}], "]"}]}], "-", 
      RowBox[{"1", "/", "2"}], "-", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "m"}], "-", "1"}], ")"}]}], " ", 
       RowBox[{"Binomial", "[", 
        RowBox[{
         RowBox[{"2", "m"}], ",", "m"}], "]"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"4", "m"}], ",", 
           RowBox[{"2", "m"}]}], "]"}], "/", 

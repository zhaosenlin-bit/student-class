Cell["Definitions", "Section",ExpressionUUID->"4f0498d6-a39e-4712-b18b-4b179247812d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], "/", "2"}], "\[LessEqual]", "x", "\[LessEqual]", 
     RowBox[{"a", "/", "2"}]}], "&&", 
    RowBox[{"0", "\[LessEqual]", "y", "\[LessEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Abs", "[", 
         RowBox[{"x", "/", 
          RowBox[{"(", 
           RowBox[{"a", "/", "2"}], ")"}]}], "]"}]}], ")"}], " ", "h"}]}]}]}],
   ";"}]], "Input",ExpressionUUID->"97d680c1-6e40-46b7-8331-d9b0d6cd4f99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"implreg", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{"ineq", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}]], "Input",ExpressionUUI\
D->"aa89afd1-7eb9-4bb0-b774-8bc467def92a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], "/", "2"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "/", "2"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "h"}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",Expre\
ssionUUID->"26cd7526-d0fc-4adc-9e1f-627f7008c622"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assum", "=", 
   RowBox[{
    RowBox[{"a", ">", "0"}], "&&", 
    RowBox[{"h", ">", "0"}]}]}], ";"}]], "Input",ExpressionUUID->"6cebd2d7-\
debf-4f37-ba7a-031bb885115b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"t", "=", 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xform", "=", 
  RowBox[{"Join", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{"unitvecs", "\[Rule]", 
      RowBox[{"ToExpression", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "<>", "\"\<hat\>\""}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{"ToString", "/@", "vars"}], ")"}]}], ")"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"-", "unitvecs"}], "\[Rule]", 
      RowBox[{"-", 
       RowBox[{"ToExpression", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "<>", "\"\<hat\>\""}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"ToString", "/@", "vars"}], ")"}]}], ")"}]}]}]}], "]"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", "zero"}], "}"}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->"24ebcd8d-3690-\
45ef-a87f-3d6f8b48f7ca"],


Cell[CellGroupData[{

Cell["Distance from O to side is half length of opposite side", "Section"],

Cell["\<\
An application of\\href{Brahmagupta's theorem} gives the pretty result that, \
for a cyclic quadrilateral with perpendicular diagonals, the distance from \
the \\href{circumcenter} $O$ to a side is half the length of the opposite \
side.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ang", "=", 
   RowBox[{"{", 
    RowBox[{".2", ",", "1.4", ",", "3.4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{
   "CyclicQuadrilateralWithPerpendicularDiagonals", "[", "ang", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"Vertices", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"Maltitudes", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mid", "=", 
   RowBox[{"Midpoints", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"o", "=", 
   RowBox[{"Circumcenter", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "A", ",", 
     RowBox[{"v", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", "B", ",", 
     RowBox[{"v", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", "C", ",", 
     RowBox[{"v", "[", 
      RowBox[{"[", "4", "]"}], "]"}], ",", "D", ",", "\[IndentingNewLine]", 
     RowBox[{"Anticenter", "[", "q", "]"}], ",", "T", ",", 
     RowBox[{"Circumcenter", "[", "q", "]"}], ",", "O", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"mid", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     SubscriptBox["M", "AB"], ",", 
     RowBox[{"mid", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     SubscriptBox["M", "BC"], ",", 
     RowBox[{"mid", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", 
     SubscriptBox["M", "CD"], ",", 
     RowBox[{"mid", "[", 
      RowBox[{"[", "4", "]"}], "]"}], ",", 
     SubscriptBox["M", "AD"]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"q", ",", "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{"q", ",", "pts", ",", ".03"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Circle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PerpSquare", "[", 
       RowBox[{
        RowBox[{"Diagonals", "[", "q", "]"}], ",", ".09", ",", "2"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Diagonals", "[", "q", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".02", ",", ".02"}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"PerpendicularLine", "[", 
           RowBox[{"o", ",", 
            RowBox[{"Line", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Partition", "[", 
          RowBox[{"v", ",", "2", ",", "1", ",", "1"}], "]"}]}]}], 
       "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "}"}], "]"}], 
   ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input"],


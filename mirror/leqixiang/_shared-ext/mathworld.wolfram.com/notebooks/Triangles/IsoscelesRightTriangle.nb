Cell["GeneralizedDiameter", "Subsection",ExpressionUUID->"ddc5c646-d6f7-44f6-b199-e2141e5e24f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ineqs", "=", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"And", "@@", 
      RowBox[{"ineq", "@@@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x1", ",", "y1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x2", ",", "y2"}], "}"}]}], "}"}]}]}], ",", 
     RowBox[{"a", ">", "0"}]}], "]"}], "/.", 
   RowBox[{"a", "\[Rule]", "1"}]}]}]], "Input",ExpressionUUID->"b26a16ba-53d8-\
46e2-8f4f-9e752a4307b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"y1", "\[GreaterEqual]", "0"}], "&&", 
  RowBox[{"1", "\[GreaterEqual]", 
   RowBox[{"x1", "+", "y1"}]}], "&&", 
  RowBox[{"x1", "\[GreaterEqual]", "0"}], "&&", 
  RowBox[{"y2", "\[GreaterEqual]", "0"}], "&&", 
  RowBox[{"1", "\[GreaterEqual]", 
   RowBox[{"x2", "+", "y2"}]}], "&&", 
  RowBox[{"x2", "\[GreaterEqual]", "0"}]}]], "Output",ExpressionUUID->\
"c3afa588-1a2c-4213-a9a4-90278198983b"]
}, Open  ]],


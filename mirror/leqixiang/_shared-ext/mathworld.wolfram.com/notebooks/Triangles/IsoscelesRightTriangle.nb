       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VertexArc", "[", 
           RowBox[{"#", ",", ".1"}], "]"}], ",", 
          RowBox[{"EqualAngleTicks", "[", 
           RowBox[{"#", ",", "1", ",", ".1", ",", ".04", ",", "0"}], "]"}]}], 
         "}"}], "&"}], "/@", 

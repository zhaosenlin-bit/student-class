     </mrow>
    </mfrac>
    <mtext>&nbsp;degree</mtext>
   </mrow>
  <mo>)</mo></mrow>
 </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <mrow><mo>(</mo>
   <mrow>
    <mn>1</mn><mtext>&nbsp;minute</mtext><mo>=</mo><mfrac>
     <mn>1</mn>
     <mrow>
      <mn>60</mn>
     </mrow>
    </mfrac>
    <mtext>&nbsp;degree</mtext>
   </mrow>
  <mo>)</mo></mrow>
 </mrow></annotation-xml></semantics></math></span>. The radius of Earth is 3960 miles.</p></div>
</div>

</section></div>
<div data-type="exercise" id="fs-id1165135419660"><header></header><section>
 <div data-type="problem" id="fs-id1165135419662">
<span class="os-number">66</span><span class="os-divider">. </span>
<div class="os-problem-container">

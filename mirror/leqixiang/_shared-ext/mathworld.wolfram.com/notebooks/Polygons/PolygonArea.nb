Cell[BoxData[
 RowBox[{"\<\"ConvexHull[{{x1,y1},{x2,y2},...,{xn,yn}}] yields the (planar) \
convex hull of the n points, represented as a list of point indices arranged \
in counterclockwise order.\"\>", " ", 
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"AddOnsLink",

          RowBox[{"i", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}], ",", 
         RowBox[{"Method", "\[Rule]", "\"\<Procedural\>\""}]}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"6", " ", 
         RowBox[{"PolygonArea", "[", "v", "]"}]}], ")"}]}]}]}], 

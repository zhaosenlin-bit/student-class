Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}]}], "==", 
      RowBox[{"r", "^", "2"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", "x"}], "+", 
       RowBox[{"b", " ", "y"}], " ", "+", 
       RowBox[{"c", " ", "z"}], "+", "d"}], "\[Equal]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "z"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"eacea3d9-8c55-44a6-ae8c-074725015575"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"z", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "d"}], "-", 
        RowBox[{"a", " ", "x"}], "-", 
        RowBox[{"b", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["r", "2"], "-", 
           SuperscriptBox["x", "2"]}]]}]}], "c"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["r", "2"], "-", 
        SuperscriptBox["x", "2"]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"z", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "d"}], "-", 
        RowBox[{"a", " ", "x"}], "+", 
        RowBox[{"b", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["r", "2"], "-", 
           SuperscriptBox["x", "2"]}]]}]}], "c"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["r", "2"], "-", 
         SuperscriptBox["x", "2"]}]]}]}]}], "}"}]}], "}"}]], "Output",Expressi\
onUUID->"8fcd7c1d-fe2e-4094-98a1-a75917a23036"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"<<", "Graphics`Colors`"}]], "Input",ExpressionUUID->"88137918-b009-45cf-9904-f3efb87d39f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CylindricalSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], ",", "r_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"#", 
           SqrtBox[
            RowBox[{
             SuperscriptBox["r", "2"], "-", 
             SuperscriptBox["x", "2"]}]]}], ",", 
          FractionBox[
           RowBox[{
            RowBox[{"-", "d"}], "-", 
            RowBox[{"a", " ", "x"}], "-", 
            RowBox[{"b", " ", 
             SqrtBox[
              RowBox[{
               SuperscriptBox["r", "2"], "-", 
               SuperscriptBox["x", "2"]}]]}]}], "c"], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Thickness", "[", ".015", "]"}], ",", "Red"}], "}"}]}], 
         "}"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "r"}], ",", "r"}], "}"}], ",", "opts", ",", 
     RowBox[{"DisplayFunction", "\[Rule]", "Identity"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",ExpressionUUID->"0c9f25a8-d206-\

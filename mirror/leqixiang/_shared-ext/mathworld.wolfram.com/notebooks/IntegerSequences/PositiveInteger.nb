Cell["Recurrence Equation", "Section",ExpressionUUID->"04d1b319-ec6a-4e67-aebb-58e4dda87681"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", "n", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"a", "[", 
        RowBox[{"n", "-", "1"}], "]"}], "+", "1"}]}], ",", 
     RowBox[{
      RowBox[{"a", "[", "1", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
   RowBox[{"a", "[", "n", "]"}], ",", "n"}], "]"}]], "Input",ExpressionUUID->\
"a0e0d3d4-f765-45a7-a58e-02a5e8ea5306"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "\[Rule]", "n"}], "}"}], "}"}]], "Output",Ex\
pressionUUID->"27d501ae-ca9d-4fdd-a2f1-261adf4195a1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Binary plot", "Section",ExpressionUUID->"a990dd85-e1cf-4f0a-9557-cef984129c3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BinaryPlot", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "n0_", ",", "nmax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"n", ",", "f"}], "]"}], "[", "k", "]"}], ",", "2"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "n0", ",", "nmax"}], "}"}]}], "]"}]}], ",", 
      "len"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Length", "/@", "data"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ArrayPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PadLeft", "[", 
           RowBox[{"#", ",", "len", ",", "0"}], "]"}], "&"}], "/@", "data"}], 
        "]"}], ",", 
       RowBox[{"Frame", "\[Rule]", "False"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"a105f790-03a0-48d5-adf5-2666387229ac"],


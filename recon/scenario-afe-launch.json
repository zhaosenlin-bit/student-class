{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:4174/" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 4000 }
  ],
  "capture": {
    "at_end": ["url", "screenshot"],
    "events": ["console", "page-errors", "network"],
    "network": { "response_body": true },
    "limits": { "max_events": 300, "max_network_body_bytes": 200000 }
  },
  "command_timeout_ms": 60000
}

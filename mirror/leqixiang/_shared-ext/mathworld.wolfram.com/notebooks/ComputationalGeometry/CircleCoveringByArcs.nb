Cell[CellGroupData[{

Cell["Plots", "Section"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RandomArcs", "[", 
   RowBox[{"a_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Hue", "[", 
       RowBox[{"i", "/", "n"}], "]"}], ",", 
      RowBox[{"Circle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", "Pi"}], ")"}]}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"0", 
            RowBox[{"i", "/", "n"}]}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"#", "+", "a"}]}], "}"}], "&"}], "@", 
         RowBox[{"Random", "[", 
          RowBox[{"Real", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"RandomArcs", "[", 
    RowBox[{".4", ",", "30"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"movie", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Circle", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"2", "Pi"}], ")"}]}]}], "]"}], ",", 
         RowBox[{"Thickness", "[", ".018", "]"}], ",", 
         RowBox[{"Take", "[", 
          RowBox[{"l", ",", "n"}], "]"}]}], "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"Length", "[", "l", "]"}]}], "}"}]}], "]"}]}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"gifs", "<>", "\"\<circarcs.gif\>\""}], ",", 
   RowBox[{"Show", "/@", "movie"}]}], "]"}]], "Input"],


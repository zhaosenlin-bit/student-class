Cell[BoxData["\<\"Cylindrical represents the cylindrical coordinate system \
with default variables Rr, Ttheta, and Zz. Cylindrical[r, theta, z] \
represents the cylindrical coordinate system with variables r, theta, and \
z.\"\>"], "Output",ExpressionUUID->"d245f902-efb8-403b-abd5-227e6b1939ff"]
}, Open  ]]

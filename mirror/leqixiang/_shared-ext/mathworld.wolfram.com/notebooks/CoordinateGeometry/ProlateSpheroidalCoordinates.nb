Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "ProlateSpheroidal"}]], "Input"],

Cell[BoxData[
 RowBox[{"\<\"ProlateSpheroidal represents the prolate spheroidal coordinate \
system with default variables Xxi, Eeta, and Pphi and default parameter value \
1. ProlateSpheroidal[xi, eta, phi] represents the prolate spheroidal \
coordinate system with variables xi, eta, and phi and default parameter value \
1. ProlateSpheroidal[xi, eta, phi, a] represents the prolate spheroidal \
coordinate system with variables xi, eta, and phi and parameter a.\"\>", " ", 
  
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"AddOnsLink",
   ButtonData:>"Calculus`VectorAnalysis`"]}]], "Print",
 CellTags->"Info3292613090-7460727"]
}, Open  ]]
}, Open  ]],


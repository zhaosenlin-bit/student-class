Cell["Equation", "Section", ExpressionUUID->"20769c6f-21ab-4d35-91ba-5d8633002db6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Plus", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"a", ",", "#"}], "]"}], 
        RowBox[{"x", "^", "#"}]}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "3"}], "]"}]}], ")"}]}], "\[Equal]", "0"}], "//", 
  "TraditionalForm"}]], "Input", \
ExpressionUUID->"29d06c03-8591-46d5-8389-98533ed7d459"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["a", "3"], " ", 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{
     SubscriptBox["a", "2"], " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{
     SubscriptBox["a", "1"], " ", "x"}], "+", 
    SubscriptBox["a", "0"]}], "==", "0"}], TraditionalForm]], "Output", \
ExpressionUUID->"4aac58a2-07db-4db0-b115-7180d6e9667e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Khayyam's conic construction", "Section", ExpressionUUID->"8877d859-964b-4f5e-938b-4096eb05c34c"],

Cell["\<\

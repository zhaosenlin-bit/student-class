{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:4174/" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 4500 },
    {
      "step_id": "open-browse",
      "action": "click",
      "locator": { "kind": "css", "selector": "a[href=\"#browse\"] >> nth=0" },
      "timeout_ms": 15000
    },
    { "step_id": "settle-2", "action": "wait_for_timeout", "duration_ms": 3500 }
  ],
  "capture": {
    "at_end": ["url", "screenshot"],
    "events": ["console", "page-errors", "network"],
    "network": { "response_body": true },
    "limits": { "max_events": 400, "max_network_body_bytes": 600000 }
  },
  "command_timeout_ms": 60000
}

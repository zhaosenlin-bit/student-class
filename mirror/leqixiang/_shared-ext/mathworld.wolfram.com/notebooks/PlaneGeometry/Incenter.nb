Cell[CellGroupData[{

Cell["Related to Altitudes", "Section",ExpressionUUID->"b2a92637-42c8-4e63-a603-e244e64f1aaf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".2", ",", ".7"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"OrthicTriangle", "[", "t", "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"t", ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"Incircle", "[", "t", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexPoints", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(A\), \(1\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(A\), \(2\)]\)\>\"", ",", 
               "\"\<\!\(\*SubscriptBox[\(A\), \(3\)]\)\>\""}], "}"}]}], "}"}],
            "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "Red"}], "]"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"VertexPoints", "[", "h", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<\!\(\*SubscriptBox[\(H\), \(1\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(H\), \(2\)]\)\>\"", ",", 
                "\"\<\!\(\*SubscriptBox[\(H\), \(3\)]\)\>\""}], "}"}]}], 
             "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Incenter", "[", "t", "]"}], ",", "\"\<I\>\"", ",", 
             "Blue"}], "}"}], "}"}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"LabelOffset", "\[Rule]", ".03"}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}], "Input",Express\
ionUUID->"0727af63-aaed-4368-8774-b7cb607ce64e"],


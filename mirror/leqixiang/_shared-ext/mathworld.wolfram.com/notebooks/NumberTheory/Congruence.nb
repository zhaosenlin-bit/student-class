Cell[CellGroupData[{

Cell["Code", "Subsection"],

Cell["Best but undocumented", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyMod", "[", 
   RowBox[{"r_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Polynomial", "[", 
   RowBox[{"r", ",", "m"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell["Straightforward", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"MyMod", ",", "Listable"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MyMod", "[", 
   RowBox[{"r_Rational", ",", "m_Integer"}], "]"}], ":=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Numerator", "[", "r", "]"}], 
     RowBox[{"PowerMod", "[", 
      RowBox[{
       RowBox[{"Denominator", "[", "r", "]"}], ",", 
       RowBox[{"-", "1"}], ",", "m"}], "]"}]}], ",", "m"}], "]"}]}]}], "Input"],

Cell["More kludgy version using Conway and Guy's algorithm", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyMod", "[", 
   RowBox[{"r_Rational", ",", "m_Integer"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"Numerator", "[", "r", "]"}]}], ",", 
      RowBox[{"q", "=", 
       RowBox[{"Denominator", "[", "r", "]"}]}]}], "}"}], ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"qi", "=", "q"}], ",", "pi", ",", 
        RowBox[{"prod", "=", "1"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"qi", ">", "1"}], ",", 
         RowBox[{
          RowBox[{"pi", "=", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"m", "/", "qi"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"prod", "*=", "pi"}], ";", "\[IndentingNewLine]", 
          RowBox[{"qi", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"qi", " ", "pi"}], ",", "m"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"p", " ", "prod"}], ",", "m"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Usage", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "PowerMod"}]], "Input"],

Cell[BoxData[
 RowBox[{"\<\"PowerMod[a, b, n] gives a^b mod n. For negative b, PowerMod[a, \
b, n] gives modular inverses.\"\>", " ", 
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"RefGuideLink",
   ButtonData:>"PowerMod"]}]], "Print",
 CellTags->"Info3294473888-7408568"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples of Fractional Congruences", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MyMod", "[", 
    RowBox[{"#", ",", "7"}], "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"1", "/", "2"}], ",", 
    RowBox[{"1", "/", "4"}], ",", 
    RowBox[{"2", "/", "3"}], ",", 
    RowBox[{"1", "/", "6"}]}], "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "2", ",", "3", ",", "6"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Numerator", "[", "#", "]"}], " ", 
      RowBox[{"PowerMod", "[", 
       RowBox[{
        RowBox[{"Denominator", "[", "#", "]"}], ",", 
        RowBox[{"-", "1"}], ",", "7"}], "]"}]}], ",", "7"}], "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"1", "/", "2"}], ",", 
    RowBox[{"1", "/", "4"}], ",", 
    RowBox[{"2", "/", "3"}], ",", 
    RowBox[{"1", "/", "6"}]}], "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "2", ",", "3", ",", "6"}], "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"p", "/", "q"}], " ", 
    RowBox[{"(", 
     RowBox[{"mod", " ", "m"}], ")"}], " ", "for", " ", 
    RowBox[{"(", 
     RowBox[{"q", ",", "m"}], ")"}]}], "\[NotEqual]", "0"}], 
  TraditionalForm]], "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MyMod", "[", 
  RowBox[{
   RowBox[{"2", "/", "7"}], ",", "14"}], "]"}]], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GCD", "[", 
  RowBox[{"7", ",", "14"}], "]"}]], "Input"],

Cell[BoxData["7"], "Output"]

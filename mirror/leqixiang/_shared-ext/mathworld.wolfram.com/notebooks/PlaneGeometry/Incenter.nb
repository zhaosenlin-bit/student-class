Cell["Manipulate", "Section",ExpressionUUID->"f1b099cc-f68e-4e33-be0d-2ba02b724f3a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Incenter", "[", 
    RowBox[{
     RowBox[{"p1", ":", 
      RowBox[{"{", 
       RowBox[{"x1_", ",", "y1_"}], "}"}]}], ",", 
     RowBox[{"p2", ":", 
      RowBox[{"{", 
       RowBox[{"x2_", ",", "y2_"}], "}"}]}], ",", 
     RowBox[{"p3", ":", 
      RowBox[{"{", 
       RowBox[{"x3_", ",", "y3_"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"p2", "-", "p3"}], "]"}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"p3", "-", "p1"}], "]"}]}], ",", 
       RowBox[{"c", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"p1", "-", "p2"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Point", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "+", "c"}], ")"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Incircle", "[", 
   RowBox[{
    RowBox[{"p1", ":", 
     RowBox[{"{", 
      RowBox[{"x1_", ",", "y1_"}], "}"}]}], ",", 
    RowBox[{"p2", ":", 
     RowBox[{"{", 
      RowBox[{"x2_", ",", "y2_"}], "}"}]}], ",", 
    RowBox[{"p3", ":", 
     RowBox[{"{", 
      RowBox[{"x3_", ",", "y3_"}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{"p2", "-", "p3"}], "]"}]}], ",", 
      RowBox[{"b", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{"p3", "-", "p1"}], "]"}]}], ",", 
      RowBox[{"c", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{"p1", "-", "p2"}], "]"}]}], ",", "center", ",", "radius"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"center", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"a", " ", "x1"}], "+", 
           RowBox[{"b", " ", "x2"}], "+", 
           RowBox[{"c", " ", "x3"}]}], ",", 
          RowBox[{
           RowBox[{"a", " ", "y1"}], "+", 
           RowBox[{"b", " ", "y2"}], "+", 
           RowBox[{"c", " ", "y3"}]}]}], "}"}], "/", 
        RowBox[{"(", 
         RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"center", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"radius", "=", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "+", "c", "-", "a"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"c", "+", "a", "-", "b"}], ")"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", "+", "b", "-", "c"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}], "]"}], "/", "2"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Circle", "[", 
      RowBox[{"center", ",", "radius"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",ExpressionUUID->"47bc8d49-f21f-44cd-8cfd-2d6d22521f36"],


Cell[CellGroupData[{

Cell["Right Angle Theorem", "Section",ExpressionUUID->"4a14fead-1053-4b1c-87e6-4c271128b40c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tri", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{".2", ",", ".5"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{
    RowBox[{"Incenter", "[", "tri", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ContactTriangle", "[", "tri", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"LineLineIntersection", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tri", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", "i"}], "}"}], ",", "c"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", "\n", "\t\t", 
    RowBox[{
     RowBox[{"Incenter", "[", "tri", "]"}], ",", "\"\<I\>\"", ",", "\n", 
     "\t\t", 
     RowBox[{"tri", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<A\>\"", ",", 
     RowBox[{"tri", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<B\>\"", ",", 
     RowBox[{"tri", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", "\"\<C\>\"", ",", "\n", "\t\t", 
     RowBox[{"c", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     "\"\<\!\(\*SubscriptBox[\(T\), \(A\)]\)\>\"", ",", 
     RowBox[{"c", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     "\"\<\!\(\*SubscriptBox[\(T\), \(B\)]\)\>\"", ",", "p", ",", 
     "\"\<P\>\""}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pts", ",", "str"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"Partition", "[", 
      RowBox[{"l", ",", "2"}], "]"}], "]"}], " ", "/.", " ", 
    RowBox[{"Point", "->", "Identity"}]}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Triangle", "[", "tri", "]"}]}], "}"}], ",", "\n", "\t\t\t", 
      RowBox[{"Incircle", "[", "tri", "]"}], ",", "\n", "\t\t\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", ".02", "]"}], ",", 
        RowBox[{"Point", "/@", "pts"}]}], "}"}], ",", "\n", "\t\t\t", 
      RowBox[{"Line", "[", "c", "]"}], ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tri", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", "p"}], "}"}], "]"}], ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tri", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "p"}], "}"}], "]"}], ",", "\n",
       "\t\t\t\t", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"str", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"pts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{"{", 
            RowBox[{".03", ",", ".03"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "pts", "]"}]}], "}"}]}], "]"}]}], "\n", 
     "\t\t\t", "}"}], "]"}], ",", "\n", "\t", 
   RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}], "Input",ExpressionUU\
ID->"5c8b8407-50e0-4574-a9f4-37afbc2b5a0f"],


Cell[CellGroupData[{

Cell["Initialization", "Subsection", ExpressionUUID->"097da8d9-9986-4c60-a0b1-559c727d5bea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"conic", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p_", ",", "e_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"e", "^", "2"}]}], ")"}], 
    RowBox[{"x", "^", "2"}]}], "-", 
   RowBox[{"2", "p", " ", "x"}], "+", 
   RowBox[{"p", "^", "2"}], "+", 
   RowBox[{"y", "^", "2"}]}]}], "\n", 
 RowBox[{
  RowBox[{"conic", "[", 
   RowBox[{"x_", ",", 
    RowBox[{"{", 
     RowBox[{"p_", ",", "e_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"y2", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", "e"}], "}"}]}], "]"}]}]}], "Input", \
ExpressionUUID->"d248aeab-f15e-4034-b520-7cf703a72854"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivation", "Section", ExpressionUUID->"68ba45d2-e9c7-4422-8768-537fbcf0cff6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"conic", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "e"}], "}"}]}], "]"}], ",", "x"}], "]"}]], "Input", \
ExpressionUUID->"93d77695-f334-40bf-b4d8-bef83d5c2e62"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["p", "2"], "-", 
  RowBox[{"2", " ", "p", " ", "x"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["e", "2"]}], ")"}], " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["y", "2"]}]], "Output", \
ExpressionUUID->"bdb47687-796a-4826-849b-d8d65068f366"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CompleteSquare", "[", 
  RowBox[{
   RowBox[{"conic", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "e"}], "}"}]}], "]"}], ",", "x"}], "]"}]], "Input", \
ExpressionUUID->"a5631686-3fda-4c35-90ec-1204ba464a87"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["e", "2"], " ", 
    SuperscriptBox["p", "2"]}], 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["e", "2"]}]], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["e", "2"]}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["p", 
        RowBox[{"1", "-", 
         SuperscriptBox["e", "2"]}]]}], "+", "x"}], ")"}], "2"]}]}]], "Output",\
 ExpressionUUID->"2f268a5d-e9e0-42af-8890-c7e221d5d4ca"]
}, Open  ]],


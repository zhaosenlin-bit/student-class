          RowBox[{
           RowBox[{
            RowBox[{"-", "b"}], "/", "2"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"b", "/", "2"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "y"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "b"}], "/", "2"}], ",", "0"}], "}"}]}], "}"}], "]"}],

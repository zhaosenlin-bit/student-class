Cell[TextData[{
 "If random points in the unit disk are chosen by selecting their polar \
coordinates (",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 ", \[Theta]) from uniform distributions r\[Element][0,1], \
\[Theta]\[Element][0,2\[Pi]), then they will be \
\[OpenCurlyDoubleQuote]bunched\[CloseCurlyDoubleQuote] near the center of the \
disk since the differential area ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", " ", "A"}], "=", 
    RowBox[{"r", " ", "d", " ", "r", " ", "d", " ", "\[Theta]"}]}], 
   TraditionalForm]]],
 " depends on ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "Rather, the coordinates should be chosen as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SqrtBox["s"]}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "=", "\[Theta]"}], TraditionalForm]]],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", 
      RowBox[{"2", "\[Pi]"}]}], ")"}]}], TraditionalForm]]],
 " are uniform distributions."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Average Distance from Center", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pts", "=", 
    RowBox[{"CircularDistribution", "[", 
     RowBox[{"10", "^", "5"}], "]"}]}], ";"}], "//", "Timing"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"4.63`", " ", "Second"}], ",", "Null"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Through", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Mean", ",", "Variance"}], "}"}], "[", 
   RowBox[{"l", "=", 
    RowBox[{"Norm", "/@", "pts"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.6660257736850521`", ",", "0.055640222697282214`"}], 
  "}"}]], "Output"]

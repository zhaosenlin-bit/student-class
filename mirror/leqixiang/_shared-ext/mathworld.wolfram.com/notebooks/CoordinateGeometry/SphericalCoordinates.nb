Cell["Initialization", "Subsection", ExpressionUUID->"c07b63fc-07ca-4f4a-9b2a-df408f33197e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sphericalVars", "=", 
   RowBox[{"vars", "\[LeftDoubleBracket]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "2"}], "}"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"CoordinateTransform", "[", 
    RowBox[{
     RowBox[{"\"\<Spherical\>\"", "\[Rule]", "\"\<Cartesian\>\""}], ",", 
     "sphericalVars"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ranges", "=", 
   RowBox[{
    RowBox[{"r", ">", "0"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "\[Theta]", "<", 
     RowBox[{"2", " ", "\[Pi]"}]}], "&&", 
    RowBox[{"0", "<", "\[Phi]", "<", "\[Pi]"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 InitializationCell->
  True, ExpressionUUID->"41a22466-8806-4c18-946b-360583fb4839"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wolfram Language Convention", "Section", ExpressionUUID->"a0e2e9c4-ff38-4501-a45b-180f53c5256d"],

Cell["\<\
The built-in Spherical chart orders coordinates as {radius, polar angle, \
azimuth}. MathWorld uses theta for azimuth and phi for polar angle. \
Accordingly, vars = {r, theta, phi} is retained throughout the geometric \
calculations, while sphericalVars = {r, phi, theta} is passed to the built-in \
chart. Component lists from chart-aware vector operators are in the \
orthonormal basis in chart order. The differential formulas are evaluated \
away from the origin and polar axis, where the chart is singular.\
\>", "Text", ExpressionUUID->"6b50a6c3-f025-4438-8c4d-c55cd8d9483b"],


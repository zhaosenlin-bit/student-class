Cell["Inradius", "Subsection",ExpressionUUID->"8c509320-0f5e-46a7-8e74-556c14ef82f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"right", "/.", 
    RowBox[{"{", 
     RowBox[{"a", "->", "1"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{"Incenter", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "=", 
    RowBox[{"Vertices", "[", "r", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "C", ",", 
     RowBox[{"v", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", "A", ",", 
     RowBox[{"v", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", "B"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bluepts", "=", 
   RowBox[{"{", 
    RowBox[{
    "i", ",", "\"\<\!\(\*\nStyleBox[\\\"I\\\",\\nFontSlant->\\\"Italic\\\"]\)\
\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"Graphics", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"r", ",", "\[IndentingNewLine]", 
      RowBox[{"PerpSquare", "[", 
       RowBox[{
        RowBox[{"Rest", "[", 
         RowBox[{"Sides", "[", "r", "]"}], "]"}], ",", ".05", ",", "4"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VertexArc", "[", 
           RowBox[{"#", ",", ".1"}], "]"}], ",", 
          RowBox[{"EqualAngleTicksAboutBisectors", "[", 
           RowBox[{"#", ",", "1", ",", ".1", ",", ".03", ",", "0"}], "]"}]}], 
         "}"}], "&"}], "/@", 
       RowBox[{"NestList", "[", 
        RowBox[{"RotateRight", ",", 
         RowBox[{"RotateLeft", "[", "v", "]"}], ",", "1"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Incircle", "[", "r", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Red", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"PerpSquare", "[", 
           RowBox[{"#", ",", ".05", ",", "2"}], "]"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PedalLines", "[", 
             RowBox[{"r", ",", "i"}], "]"}], ",", 
            RowBox[{"Sides", "[", "r", "]"}]}], "}"}], "]"}]}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".02", ",", ".02"}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PedalLines", "[", 
         RowBox[{"r", ",", "i"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Blue", ",", "\[IndentingNewLine]", 
        RowBox[{"PointLabels", "[", 
         RowBox[{"r", ",", "bluepts", ",", ".03", ",", ".05"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"Coordinates", "@", "i"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Vertices", "[", "r", "]"}], ",", "2", ",", "1", ",", 
           "1"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{"r", ",", "pts", ",", ".03", ",", 
        RowBox[{"-", ".05"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"9673beeb-cdfb-4234-\
9353-5ae3aca8ccc5"],


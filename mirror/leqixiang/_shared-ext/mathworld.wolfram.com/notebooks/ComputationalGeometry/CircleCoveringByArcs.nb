Cell[TextData[{
 "Probability of ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]]],
 " gaps"
}], "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"n","l"},
    "Binomial"], " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "l"}], "k"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"j", "-", "l"}]], " ", 
     SuperscriptBox[

Cell["Code", "Subsection",ExpressionUUID->"5647d118-5429-4fa0-b899-7b6ed42e462a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgefind", "::", "\"\<usage\>\""}], "=", 
  "\"\<edgefind[poly] returns the edges of equilateral regular \
polytopes.\>\""}], "\n", 
 RowBox[{
  RowBox[{"mag", "::", "\"\<usage\>\""}], "=", 
  "\"\<mag[v_] returns the norm or magnitude of the n-vector 'v'.\>\""}], "\n\
", 
 RowBox[{
  RowBox[{"nCube", "::", "\"\<usage\>\""}], "=", 
  "\"\<nCube[n] gives the 2^n vertices of an n-dimensional cube centered upon \
the origin, of edge length 2, and with its bounding hyperplanes parallel to \
the coordinate hyperplanes.\>\""}], "\n", 
 RowBox[{
  RowBox[{"xyCube", "::", "\"\<usage\>\""}], "=", 
  "\"\<xyCube[n] gives the 2^n vertices of an n-dimensional cube centered \
upon the origin, of edge length Sqrt[2n], such that the projection into the \
{x,y} plane is isometric.\>\""}], "\n", 
 RowBox[{
  RowBox[{"nCross", "::", "\"\<usage\>\""}], "=", 
  "\"\<nCross[n] gives the 2n vertices of an n-dimensional cross polytope or \
orthoplex, centered upon the origin, of edge length Sqrt[2], and unit \
circumradius.\>\""}], "\n", 
 RowBox[{
  RowBox[{"xyCross", "::", "\"\<usage\>\""}], "=", 
  "\"\<xyCross[n] gives the 2^n vertices of an n-dimensional cross polytope \
centered upon the origin, of edge length Sqrt[n], such that the projection \
into the {x,y} plane is especially symmetrical.\>\""}], "\n", 
 RowBox[{
  RowBox[{"nSimplex", "::", "\"\<usage\>\""}], "=", 
  "\"\<nSimplex[n] gives the (n+1) vertices of an n-simplex of edge \
Sqrt[n+1].\>\""}], "\n", 
 RowBox[{
  RowBox[{"zonotope", "::", "\"\<usage\>\""}], "=", 
  "\"\<zonotope[vectors] accepts a list of n-vectors 'vectors'. It returns \
2^(Length[vectors]) n-vectors, which are the projection (possibly oblique) of \
the vertices of a (Length[vectors])-orthotope into the n-space.  Example: \
zonotope[{{1,0,0},{0,1,0},{0,0,1}}] returns the vertices of a \
3-cube.\>\""}]}], "Input",ExpressionUUID->"1c49d70d-755d-46a3-b3cf-\
53598fa2d72d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolytopeGraph", "[", 
    RowBox[{"poly_", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "&"}], ",", 
          "poly"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "&"}], ",", 
          RowBox[{"edgefind", "[", "poly", "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Line", "/@", "b"}], ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
         RowBox[{"AbsolutePointSize", "[", "4", "]"}], ",", "opts", ",", 
         RowBox[{"Point", "/@", "a"}]}], "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgefind", "[", "poly_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mag", "[", 
              RowBox[{
               RowBox[{"First", "@", "poly"}], "-", "#"}], "]"}], "&"}], ",", 
            
            RowBox[{"Rest", "@", "poly"}]}], "]"}], ",", 
          RowBox[{"SameTest", "\[Rule]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], "\[Equal]", "0"}], "&"}], 
            ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "=", 
            RowBox[{"Drop", "[", 
             RowBox[{"poly", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "@", "a"}], ",", "#"}], "}"}], "&"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Rest", "@", "a"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"mag", "[", 
                   RowBox[{
                    RowBox[{"First", "@", "a"}], "-", "#"}], "]"}], "-", 
                  "b"}], "]"}], "<", ".001"}], "&"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "poly", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nCube", "[", "n_", "]"}], ":=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xyCube", "[", "n_", "]"}], ":=", 
   RowBox[{"zonotope", "[", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"xyCross", "[", "n", "]"}], ",", "n"}], "]"}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nCross", "[", "n_", "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ",", 
     RowBox[{"IdentityMatrix", "[", "n", "]"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyCross", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "r", ",", "k"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "section", " ", "13.4", " ", "of", " ", "Regular", " ", "Polytopes"}], 
      "*)"}], 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Through", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Cos", ",", "Sin"}], "}"}], "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "r"}], "-", "1"}], ")"}], " ", "Pi", " ", 
               RowBox[{"k", "/", "n"}]}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{"Floor", "[", 
               RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"2", " ", "n"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "n", "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", "k"}], "/", 
              RowBox[{"Sqrt", "[", "2", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"2", " ", "n"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"(*", "Else", "*)"}], "a"}], "]"}]}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nSimplex", "[", "n_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "r", ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"2", " ", "Pi", " ", "k", " ", 
                 RowBox[{"r", "/", 
                  RowBox[{"(", 
                   RowBox[{"n", "+", "1"}], ")"}]}]}], "]"}], ",", 
               RowBox[{"Sin", "[", 
                RowBox[{"2", " ", "Pi", " ", "k", " ", 
                 RowBox[{"r", "/", 
                  RowBox[{"(", 
                   RowBox[{"n", "+", "1"}], ")"}]}]}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "n", "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", "k"}], ")"}], "/", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "}"}]}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], ",", "a"}], "]"}]}]}], 
    "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mag", "[", "v_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"v", ".", "v"}], "]"}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zonotope", "[", "vectors_List", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"nCube", "[", 
      RowBox[{"Length", "[", "vectors", "]"}], "]"}], ".", "vectors"}], 
    ")"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Isometric", "[", "poly_", "]"}], ":=", 
  RowBox[{"Graphics", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Line", "/@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "&"}], ",", 
         RowBox[{"edgefind", "[", "poly", "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", 
      RowBox[{"Point", "/@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "&"}], ",", 
         "poly"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"efe5621c-59fe-4e4a-88ed-f640db723567"]
}, Open  ]],


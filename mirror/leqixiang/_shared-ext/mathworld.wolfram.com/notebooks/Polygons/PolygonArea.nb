Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonArea", "[", 
   RowBox[{"l_List", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Det", "/@", 
      RowBox[{"Partition", "[", 
       RowBox[{"l", ",", "2", ",", "1", ",", "1"}], "]"}]}], "]"}], "/", 
    "2"}], "/;", 
   RowBox[{
    RowBox[{
     RowBox[{"Dimensions", "[", "l", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "2"}]}]}]], "Input",Expressio\
nUUID->"82b28c06-3ed3-41d4-b19d-71ae1fa3c365"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegularPolygonArea", "[", 
   RowBox[{"n_Integer", ",", 
    RowBox[{"R_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"n", " ", 
    RowBox[{"R", "^", "2"}], 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "n"}]}], "]"}], "/", "2"}]}], "/;", 
   RowBox[{"n", "\[GreaterEqual]", "3"}]}]}]], "Input",ExpressionUUID->\
"c766012a-57f7-4754-8cc2-824f3277db66"],


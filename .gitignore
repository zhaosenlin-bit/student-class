# ---------------------------------------------------------------------
# What stays out of the repository.
#
# The project is the server, the tools and the mirrored library. The
# things below are either toolchains that a machine installs for itself,
# build output that can be produced again, or working files that belong
# to one run.
# ---------------------------------------------------------------------

# Toolchains and build output
tools/node24/
tools/mingw64/
tools/mingw-binutils/
tools/.cache/
craft-anything/target/
.cargo/

# Browser profiles used for crawling and for the verification runs
tools/chrome-*/

# The vendored upstream projects keep their own history, and it stays on
# this machine (C:\kaifa\_vendored-git-backup) instead of in the repo.
rea/.git/
rea-src/.git/
craft-anything/.git/

# rea-src/ is a byte-for-byte copy of rea/. Only one of them is tracked.
rea-src/

# Working files of a single run
recon/captures/
recon/rust-hello/
recon/scratch/*
# The reports that document the library are kept; the pictures and the
# logs of a single run are not.
!recon/scratch/*.json

# Credentials that belong to one account, never to the repository
recon/scratch/*.txt
recon/scratch/*.cookie
recon/scratch/afe-user.json
*.token
*.cookie
.env
.env.*

# Editor and OS noise
.DS_Store
Thumbs.db
*.tmp
*.log
*.err
__pycache__/

# Node
node_modules/
npm-debug.log*

 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Usage", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "ConfocalEllipsoidal"}]], "Input"],

Cell[BoxData[
 RowBox[{"\<\"ConfocalEllipsoidal represents the confocal ellipsoidal \
coordinate system with default variables Llambda, Mmu, and Nnu and default \
parameter values 3, 2, and 1. ConfocalEllipsoidal[lambda, mu, nu] represents \
the confocal ellipsoidal coordinate system with variables lambda, mu, and nu \
and default parameter values 3, 2, and 1. ConfocalEllipsoidal[lambda, mu, nu, \
a, b, c] represents the confocal ellipsoidal coordinate system with variables \
lambda, mu, and nu and parameters a, b, and c.\"\>", " ", 
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"AddOnsLink",
   ButtonData:>"Calculus`VectorAnalysis`"]}]], "Print",
 CellTags->"Info3292612653-9092302"]
}, Open  ]]
}, Open  ]],


Cell[CellGroupData[{

Cell["Usage", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Bispherical"}]], "Input"],

Cell[BoxData[
 RowBox[{"\<\"Bispherical represents the bispherical coordinate system with \
default variables Uu, Vv, and Pphi and default parameter value 1. \
Bispherical[u, v, phi] represents the bispherical coordinate system with \
variables u, v, and phi and default parameter value 1. Bispherical[u, v, phi, \
a] represents the bispherical coordinate system with variables u, v, and phi \
and parameter a.\"\>", " ", 
  ButtonBox[
   StyleBox["More\[Ellipsis]", "SR"],
   Active->True,
   BaseStyle->"AddOnsLink",
   ButtonData:>"Calculus`VectorAnalysis`"]}]], "Print",
 CellTags->"Info3292612514-4766841"]
}, Open  ]]
}, Open  ]],


Cell[CellGroupData[{

Cell["Examples", "Section",ExpressionUUID->"0be7fb46-76a8-42cd-99ff-3d3dd3c7c9d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"laminae", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"EntityList", "[", 
     RowBox[{"EntityClass", "[", 
      RowBox[{"\"\<Lamina\>\"", ",", "\"\<Polygon\>\""}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<VertexCount\>\"", "]"}], "\[Equal]", "5"}], 
     "&"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"bf41235f-3fc1-4318-963a-d38aa08bbc7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"\"isosceles pentagon\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"FilledIsoscelesPentagon\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"FilledIsoscelesPentagon\\\"]\"",
     "\"lamina\""},
    "Entity"], ",", 
   TemplateBox[{"\"isosceles right pentagon\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"FilledIsoscelesRightPentagon\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"FilledIsoscelesRightPentagon\\\"]\"",
     "\"lamina\""},
    "Entity"], ",", 
   TemplateBox[{"\"regular pentagon\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"FilledRegularPentagon\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"FilledRegularPentagon\\\"]\"","\"lamina\""},
    "Entity"]}], "}"}]], "Output",
 CellLabel->
  "Out[106]=",ExpressionUUID->"eda0bfcd-10b8-4dcf-bb55-968614fd1993"]
}, Open  ]],


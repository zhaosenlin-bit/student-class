Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "Cube", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "Octahedron", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "Cuboctahedron", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "TruncatedOctahedron", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0", ",", " ", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "TruncatedCube", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "-", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "SmallRhombicuboctahedron", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "+", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vector", "[", "SnubCube", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"Root", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", "#1", "+", 
         SuperscriptBox["#1", "2"], "+", 
         SuperscriptBox["#1", "3"]}], "&"}], ",", "1"}], "]"}], ",", 
     RowBox[{"Root", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"3", " ", "#1"}], "+", 
         SuperscriptBox["#1", "2"], "+", 
         SuperscriptBox["#1", "3"]}], "&"}], ",", "1"}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"36857696-7ccc-484e-9c33-28cda72bb201"],


Cell[CellGroupData[{

Cell["Initialization", "Subsection"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "PlaneGeometry`"}], ";"}]], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Old Code (what is this?!)", "Section"],

Cell["\<\
s[sides_List]:=Plus @@ sides/2
CyclicQuadrilateralA[sides_List]:=Module[{s0=s[sides]},
  Sqrt[Product[s0-sides[[i]],{i,4}]]
]
CyclicQuadrilateralR[sides_List]:=Module[
  {s0=s[sides],a=sides[[1]],b=sides[[2]],c=sides[[3]],d=sides[[4]]},
  Sqrt[(a c+b d)(a d+b c)(a b+c d)/(s0-a)/(s0-b)/(s0-c)/(s0-d)]/4
]
CyclicQuadrilateralP[sides_List]:=Module[
  {a=sides[[1]],b=sides[[2]],c=sides[[3]],d=sides[[4]]},
  Sqrt[(a b+c d)(a c+b d)/(a d+b c)]
]
CyclicQuadrilateralQ[sides_List]:=Module[
  {a=sides[[1]],b=sides[[2]],c=sides[[3]],d=sides[[4]]},
  Sqrt[(a c+b d)(a d+b c)/(a b+c d)]
]
CyclicQuadrilateral[sides_List]:={CyclicQuadrilateralP[sides],
  CyclicQuadrilateralQ[sides],CyclicQuadrilateralR[sides],\
CyclicQuadrilateralA[sides]}\
\>", "Input",
 AspectRatioFixed->True],

Cell[CellGroupData[{

Cell["CyclicQuadrilateral[{25,33,39,65}]", "Input",
 AspectRatioFixed->True],

Cell[OutputFormData["\<\
{60, 52, 65/2, 1344}\
\>", "\<\
         65
{60, 52, --, 1344}
         2\
\>"], "Output",
 Evaluatable->False,
 AspectRatioFixed->True]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Diagram", "Section"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v", "=", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"CyclicQuadrilateral", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".4", ",", "2.", ",", "4."}], "}"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "4"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"d", "[", "i_", "]"}], "[", "tri_", "]"}], ":=", 
   RowBox[{
    RowBox[{"DiagonalMidpoints", "[", "tri", "]"}], "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m", "[", "i_", "]"}], "[", "tri_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Midpoints", "[", "tri", "]"}], "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dd", "=", 
   RowBox[{"LineLineIntersection", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Diagonals", "[", "v", "]"}], " ", "/.", " ", 
      RowBox[{"Line", "->", "Identity"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alt", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"d", "[", "1", "]"}], "[", "v", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"d", "[", "2", "]"}], "[", "v", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "dd"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vert", "[", "i_", "]"}], "[", "tri_", "]"}], ":=", 
   RowBox[{"tri", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pts", "=", 
    RowBox[{"{", 
     RowBox[{"Centroid", ",", "\"\<G\>\"", ",", 
      RowBox[{"d", "[", "1", "]"}], ",", 
      "\"\<\!\(\*SubscriptBox[\(M\), \(AC\)]\)\>\"", ",", 
      RowBox[{"d", "[", "2", "]"}], ",", 
      "\"\<\!\(\*SubscriptBox[\(M\), \(BD\)]\)\>\"", ",", "\n", "\t", 
      "Circumcenter", ",", "\"\<O\>\"", ",", "\t", "Anticenter", ",", 
      "\"\<T\>\"", ",", "dd", ",", "\"\<P\>\"", ",", "\n", "\t", 
      RowBox[{"vert", "[", "1", "]"}], ",", "\"\<A\>\"", ",", 
      RowBox[{"vert", "[", "2", "]"}], ",", "\"\<B\>\"", ",", 
      RowBox[{"vert", "[", "3", "]"}], ",", "\"\<C\>\"", ",", 
      RowBox[{"vert", "[", "4", "]"}], ",", "\"\<D\>\""}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\n", "\t", 
     RowBox[{
      RowBox[{"Quadrilateral", "[", "v", "]"}], ",", "\n", "\t", 
      RowBox[{"Circle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", "\n", "\t", 
      RowBox[{"Line", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Circumcenter", "[", "v", "]"}], ",", 
          RowBox[{"Anticenter", "[", "v", "]"}]}], "}"}], " ", "/.", " ", 
        RowBox[{"Point", "->", "Identity"}]}], "]"}], ",", "\n", "\t", 
      RowBox[{"PointLabels", "[", 
       RowBox[{"v", ",", "pts", ",", ".03", ",", 
        RowBox[{"{", 
         RowBox[{".04", ",", ".06"}], "}"}]}], "]"}], ",", "\n", "\t", 
      RowBox[{"Altitudes", "[", "alt", "]"}], ",", 
      RowBox[{"Triangle", "[", "alt", "]"}], ",", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".03", ",", ".03"}], "}"}], "]"}], ",", 
        RowBox[{"Diagonals", "[", "v", "]"}]}], "}"}], ",", "\n", "\t\t\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".01", ",", ".01"}], "}"}], "]"}], ",", 
        RowBox[{"Maltitudes", "[", "v", "]"}]}], "}"}]}], "\n", "}"}], "]"}], 
   ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}], "Input"],


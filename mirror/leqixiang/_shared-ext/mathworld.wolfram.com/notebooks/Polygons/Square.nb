Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"#", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ",", 
          RowBox[{"Abs", "[", "y", "]"}]}], "]"}], "\[Equal]", "1"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{"Maximize", ",", "Minimize"}], "}"}]}]], "Input",ExpressionUUID->\

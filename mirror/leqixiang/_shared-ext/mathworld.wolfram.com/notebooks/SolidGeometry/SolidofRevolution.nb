Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"r", "=", ".5"}], ",", 
     RowBox[{"n", "=", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Cylinder", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"h", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                FractionBox["x", "r"]}], ")"}]}]}], "}"}], ",", "x", ",", 
           RowBox[{"PlotPoints", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"Ceiling", "[", 
                RowBox[{"2", "r"}], "]"}]}], ",", "20"}], "}"}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{"r", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"1", "/", "n"}]}], ")"}]}], ",", 
           RowBox[{"r", "/", "n"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
       "}"}], "]"}], ",", 
     RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"492b0990-49bc-43a6-\
865c-dd0df4839b56"],


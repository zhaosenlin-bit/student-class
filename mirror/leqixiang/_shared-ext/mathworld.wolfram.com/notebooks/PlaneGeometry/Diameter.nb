Cell[BoxData[
 RowBox[{"sphere", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "u", "]"}], 
          RowBox[{"Sin", "[", "v", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "u", "]"}], 
          RowBox[{"Sin", "[", "v", "]"}]}], ",", 
         RowBox[{"Cos", "[", "v", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", "None"}], ",", 

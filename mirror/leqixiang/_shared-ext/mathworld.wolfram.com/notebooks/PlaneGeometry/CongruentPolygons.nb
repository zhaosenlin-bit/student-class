Cell["Figure", "Section", ExpressionUUID->"c7c4c361-1a95-4a08-990a-b93538791e17"],

Cell["Two congruent polygons related by a rigid motion.", "Text", ExpressionUUID->"351952c5-d6d7-49d8-b349-42abe4004f85"],

Cell[CellGroupData[{

Cell["\<\
With[
\t{
\t\tp = {{0.5, 0.4}, {2.8, 0.6}, {3.3, 1.9}, {2.1, 2.8}, {0.8, 2.1}},
\t\tq = RotationTransform[-Pi/7][#] + {4.4, 1.2} & ,
\t\tink = LightDarkSwitched[RGBColor[0.217, 0.217, 0.217], RGBColor[0.867, \
0.867, 0.867]],
\t\tfill = LightDarkSwitched[RGBColor[0.8, 0.87, 0.98], RGBColor[0.25, 0.38, \
0.62]]
\t},
\tWith[
\t\t{
\t\t\tlabelPoints = Function[vertices,
\t\t\t\tMapThread[
\t\t\t\t\tFunction[{vertex, previous, next},
\t\t\t\t\t\tvertex - 0.28 Normalize[Normalize[previous - vertex] + \
Normalize[next - vertex]]
\t\t\t\t\t],
\t\t\t\t\t{vertices, RotateRight[vertices], RotateLeft[vertices]}
\t\t\t\t]
\t\t\t]
\t\t},
\t\tGraphics[
\t\t\t{
\t\t\t\tEdgeForm[Directive[ink, AbsoluteThickness[2]]],
\t\t\t\tFaceForm[fill],
\t\t\t\tPolygon[p],
\t\t\t\tPolygon[q /@ p],
\t\t\t\tMapThread[
\t\t\t\t\tText[Style[#1, ink, Italic, FontFamily -> \"Times\", 15], #2] & ,
\t\t\t\t\t{{\"A\", \"B\", \"C\", \"D\", \"E\"}, labelPoints[p]}
\t\t\t\t],
\t\t\t\tMapThread[
\t\t\t\t\tText[Style[#1, ink, Italic, FontFamily -> \"Times\", 15], #2] & ,
\t\t\t\t\t{{\"A'\", \"B'\", \"C'\", \"D'\", \"E'\"}, labelPoints[q /@ p]}
\t\t\t\t]
\t\t\t}
\t\t]
\t]
]\
\>", "Input",
 CellLabel->
  "In[246]:=", ExpressionUUID->"515527f0-0c29-434c-9c13-bffb7b8995f4"],


Cell[CellGroupData[{

Cell["Check", "Section"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "+", "c"}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"s", 
     RowBox[{"(", 
      RowBox[{"s", "-", "a"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"s", "-", "b"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"s", "-", "c"}], ")"}]}], "]"}]}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"A", "-", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "^", "2"}], 
          RowBox[{"b", "^", "2"}]}], "+", 
         RowBox[{
          RowBox[{"a", "^", "2"}], 
          RowBox[{"c", "^", "2"}]}], "+", 
         RowBox[{
          RowBox[{"b", "^", "2"}], 
          RowBox[{"c", "^", "2"}]}]}], ")"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", "^", "4"}], "+", 
        RowBox[{"b", "^", "4"}], "+", 
        RowBox[{"c", "^", "4"}]}], ")"}]}], "]"}], "/", "4"}]}], 
  "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"A", "-", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", "b", "+", "c"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "a"}], "+", "b", "+", "c"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"a", "-", "b", "+", "c"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"a", "+", "b", "-", "c"}], ")"}]}], "]"}], "/", "4"}]}], 
  "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"A", "-", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "a", " ", "b"}], ")"}], "^", "2"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "^", "2"}], "+", 
         RowBox[{"b", "^", "2"}], "-", 
         RowBox[{"c", "^", "2"}]}], ")"}], "^", "2"}]}], "]"}], "/", "4"}]}], 
  "]"}]], "Input"],


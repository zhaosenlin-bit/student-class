xpressionUUID->"09b14e72-a2dd-4f8e-8174-c5770ca1b932"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"a", " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "v"}], "]"}]}], "+", 
       RowBox[{"Cosh", "[", 
        RowBox[{"2", " ", "u"}], "]"}]}]]}], 
    SqrtBox["2"]], ",", 
   FractionBox[
    RowBox[{"a", " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "v"}], "]"}]}], "+", 
       RowBox[{"Cosh", "[", 
        RowBox[{"2", " ", "u"}], "]"}]}]]}], 
    SqrtBox["2"]], ",", "1"}], "}"}]], "Output",ExpressionUUID->"85ead810-\

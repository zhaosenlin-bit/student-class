         SuperscriptBox["b", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "v", "]"}], "2"]}]}]]], "]"}], "-", 
    RowBox[{"ArcSin", "[", 
     FractionBox[
      RowBox[{"Cot", "[", "v", "]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{"b", "^", "2"}], "-", "1"}]]], "]"}]}], ",", 
   RowBox[{
    RowBox[{"b", ">", "0"}], "&&", 
    RowBox[{"v", ">", "0"}]}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"ArcSin", "[", 
    FractionBox[
     RowBox[{"Cot", "[", "v", "]"}], 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", 

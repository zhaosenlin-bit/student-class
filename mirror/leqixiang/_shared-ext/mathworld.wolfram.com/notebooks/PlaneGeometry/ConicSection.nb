Cell[BoxData[
 RowBox[{"PowerExpand", "[", 
  RowBox[{"Together", "//@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"a", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"e", "^", "2"}]}], ")"}], "/", "e"}]}], " ", "/.", " ", 
     RowBox[{"e", "\[Rule]", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 

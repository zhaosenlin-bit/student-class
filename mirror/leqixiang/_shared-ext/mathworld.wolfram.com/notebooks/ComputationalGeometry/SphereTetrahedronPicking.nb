Cell[CellGroupData[{

Cell["Monte Carlo", "Subsection",ExpressionUUID->"fd1a0b42-0803-456c-820a-5460fa11cc5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalDistribution", "[", "num_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "#1", "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "#1", "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", "#2"}], "}"}], "&"}], 
     "[", 
     RowBox[{
      RowBox[{"Random", "[", 
       RowBox[{"Real", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Random", "[", 
       RowBox[{"Real", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", "num", "}"}]}], "]"}]}]], "Input",ExpressionUUID->"395714c2-\
8198-40f8-ae05-1e03ca838cff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Length", "[", 
   RowBox[{"pts", "=", 
    RowBox[{"Abs", "/@", 
     RowBox[{"TetrahedronVolume", "/@", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"SphericalDistribution", "[", 
         RowBox[{"10", "^", "7"}], "]"}], ",", "4"}], "]"}]}]}]}], "]"}], "//",
   "Timing"}]], "Input",ExpressionUUID->"74938c7f-514c-44a0-b7c9-\
3c49dcd65701"],


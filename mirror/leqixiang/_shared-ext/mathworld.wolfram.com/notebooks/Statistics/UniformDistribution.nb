Cell[BoxData[
 FormBox[
  TagBox[
   FormBox[
    TagBox[GridBox[{
       {"Domain", 
        TagBox[
         RowBox[{"Interval", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], "]"}],
         HoldForm]},
       {
        RowBox[{"P", "(", "x", ")"}], 
        FractionBox[
         RowBox[{
          RowBox[{"sgn", "(", 
           RowBox[{"x", "-", "a"}], ")"}], "-", 
          RowBox[{"sgn", "(", 
           RowBox[{"x", "-", "b"}], ")"}]}], 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"b", "-", "a"}], ")"}]}]]},
       {
        RowBox[{"D", "(", "x", ")"}], 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b", "-", "x"}], ")"}], " ", 
              RowBox[{"sgn", "(", 
               RowBox[{"b", "-", "x"}], ")"}]}], 
             RowBox[{"b", "-", "a"}]]}], "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "a"}], ")"}], " ", 
             RowBox[{"sgn", "(", 
              RowBox[{"x", "-", "a"}], ")"}]}], 
            RowBox[{"b", "-", "a"}]], "+", "1"}], ")"}]}]},
       {"\[Mu]", 
        FractionBox[
         RowBox[{"a", "+", "b"}], "2"]},
       {
        SuperscriptBox["\[Sigma]", "2"], 
        RowBox[{
         FractionBox["1", "12"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"b", "-", "a"}], ")"}], "2"]}]},
       {
        SubscriptBox["\[Gamma]", "1"], "0"},
       {
        SubscriptBox["\[Gamma]", "2"], 
        RowBox[{"-", 
         FractionBox["6", "5"]}]}
      },
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxSpacings->{"Columns" -> {

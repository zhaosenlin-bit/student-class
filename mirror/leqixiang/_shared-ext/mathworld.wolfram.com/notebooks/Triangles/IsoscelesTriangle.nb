Cell[CellGroupData[{

Cell["Equations", "Section",ExpressionUUID->"9f2ceb90-aa00-492d-9d84-f7cb64913f3e"],

Cell[CellGroupData[{

Cell["Inequality", "Subsection",ExpressionUUID->"10212a0e-c4ce-4034-80f8-1efb27d815db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "a"}], "/", "2"}], "<", "x", "<", 
    RowBox[{"a", "/", "2"}]}], "&&", 
   RowBox[{"0", "<", "y", "<", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Abs", "[", 
        FractionBox["x", 
         RowBox[{"a", "/", "2"}]], "]"}]}], ")"}], "h"}]}]}]}]], "Input",Expre\
ssionUUID->"c1281819-9d5a-4676-9472-fe746401d7c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{

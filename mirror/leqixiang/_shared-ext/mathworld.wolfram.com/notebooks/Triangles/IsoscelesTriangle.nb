Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "=", "1"}], ",", 
     RowBox[{"h", "=", "2"}]}], "}"}], ",", 
   RowBox[{"InequalityPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "a"}], "/", "2"}], "<", "x", "<", 
       RowBox[{"a", "/", "2"}]}], "&&", 
      RowBox[{"0", "<", "y", "<", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Abs", "[", 
           FractionBox["x", 
            RowBox[{"a", "/", "2"}]], "]"}]}], ")"}], "h"}]}]}], ",", 
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{"{", "y", "}"}], ",", 
     RowBox[{"Ticks", "\[Rule]", "None"}]}], "]"}]}], "]"}]], "Input",Expressi\
onUUID->"9169ac07-bead-4dbc-b598-49446a7f297b"],


Cell[CellGroupData[{

Cell["Initialization", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<<", "PlaneGeometry`"}]], "Input",
 InitializationCell->True],

Cell[BoxData["\<\"Rehashing triangle centers...\"\>"], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure", "Section"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".3", ",", ".7"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"t", ",", "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{"LabelOffset", "\[Rule]", ".03"}], "}"}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"VertexPoints", "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
               "}"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{"LabelOffset", "\[Rule]", ".08"}], "}"}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"VertexPoints", "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<1:0:0\>\"", ",", "\"\<0:1:0\>\"", ",", "\"\<0:0:1\>\""}], 
               "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"PointSize", "[", ".025", "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input"],


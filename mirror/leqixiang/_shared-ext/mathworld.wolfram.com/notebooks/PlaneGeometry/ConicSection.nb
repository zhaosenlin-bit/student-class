Cell[CellGroupData[{

Cell["Classification table", "Section", ExpressionUUID->"01f2ea50-5de1-4ef7-9eac-c085424bbea2"],

Cell["\<\
Blue curves represent the four real nondegenerate conic types. Orange \
segments show the radius, the two focal distances, or equal focus and \
directrix distances. The hyperbola also shows its asymptotes in green. All \
marked sample points satisfy their canonical equations exactly.\
\>", "Text", ExpressionUUID->"561d8faa-8552-4c21-a893-58e9174aae06"],

Cell[BoxData[
  RowBox[{"(", RowBox[{RowBox[{RowBox[{"conicTableCurve", "[", 
          RowBox[{"coordinates_", ",", " ", "parameter_List"}], "]"}], " ", 
        ":=", " ", RowBox[{"Cases", "[", RowBox[
           {RowBox[{"ParametricPlot", "[", RowBox[{"coordinates", ",", " ", 
                "parameter"}], "]"}], ",", " ", RowBox[
             {RowBox[{"Line", "[", RowBox[{"points_", "?", "MatrixQ"}], 
                "]"}], " ", ":>", " ", RowBox[{"Line", "[", "points", 
                "]"}]}], ",", " ", "Infinity"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"conicTableFigure", "[", "key_", "]"}], " ", ":=", " ", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"neutral", ",", 
                " ", "blue", ",", " ", "orange", ",", " ", "green", ",", " ", 
                "curve", ",", " ", "foci", ",", " ", "construction", ",", 
                " ", "labels", ",", " ", "p", ",", " ", "a", ",", " ", "b", 
                ",", " ", "c"}], "}"}], ",", " ", 
            RowBox[{RowBox[{"neutral", " ", "=", " ", RowBox[
                 {"LightDarkSwitched", "[", RowBox[{"Black", ",", " ", 
                    "White"}], "]"}]}], ";", " ", RowBox[{"blue", " ", "=", 
                " ", RowBox[{"RGBColor", "[", RowBox[{RowBox[{"1", "/", 
                      "10"}], ",", " ", RowBox[{"2", "/", "5"}], ",", " ", 
                    RowBox[{"3", "/", "4"}]}], "]"}]}], ";", " ", 
              RowBox[{"orange", " ", "=", " ", RowBox[{"RGBColor", "[", 
                  RowBox[{RowBox[{"4", "/", "5"}], ",", " ", RowBox[
                     {"2", "/", "5"}], ",", " ", RowBox[{"1", "/", "10"}]}], 
                  "]"}]}], ";", " ", RowBox[{"green", " ", "=", " ", 
                RowBox[{"RGBColor", "[", RowBox[{RowBox[{"1", "/", "10"}], 
                    ",", " ", RowBox[{"3", "/", "5"}], ",", " ", RowBox[
                     {"2", "/", "5"}]}], "]"}]}], ";", " ", RowBox[{"Switch", 
                "[", RowBox[{"key", ",", " ", "\"Circle\"", ",", " ", 
                  RowBox[{RowBox[{"curve", " ", "=", " ", RowBox[{"Circle", 
                        "[", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", 
                          "0"}], "}"}], ",", " ", "2"}], "]"}]}], ";", " ", 
                    RowBox[{"foci", " ", "=", " ", RowBox[{"{", RowBox[
                         {"{", RowBox[{"0", ",", " ", "0"}], "}"}], "}"}]}], 
                    ";", " ", RowBox[{"p", " ", "=", " ", RowBox[{"{", 
                        RowBox[{RowBox[{"6", "/", "5"}], ",", " ", RowBox[
                          {"8", "/", "5"}]}], "}"}]}], ";", " ", RowBox[
                     {"construction", " ", "=", " ", RowBox[{"{", RowBox[
                         {"orange", ",", " ", RowBox[{"Line", "[", RowBox[
                          {"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", 
                          "0"}], "}"}], ",", " ", "p"}], "}"}], "]"}]}], 
                        "}"}]}], ";", " ", RowBox[{"labels", " ", "=", " ", 
                      RowBox[{"{", RowBox[{RowBox[{"Text", "[", RowBox[
                          {RowBox[{"Style", "[", RowBox[{"\"O\"", ",", " ", 
                          "Italic"}], "]"}], ",", " ", RowBox[{"{", RowBox[
                          {RowBox[{"-", RowBox[{"4", "^", RowBox[{"(", RowBox[
                          {"-", "1"}], ")"}]}]}], ",", " ", RowBox[{"-", 
                          RowBox[{"4", "^", RowBox[{"(", RowBox[{"-", "1"}], 
                          ")"}]}]}]}], "}"}]}], "]"}], ",", " ", RowBox[
                          {"Text", "[", RowBox[{RowBox[{"Style", "[", RowBox[
                          {"\"r\"", ",", " ", "Italic"}], "]"}], ",", " ", 
                          RowBox[{RowBox[{"p", "/", "2"}], " ", "+", " ", 
                          RowBox[{"{", RowBox[{RowBox[{"-", RowBox[{"5", "^", 
                          RowBox[{"(", RowBox[{"-", "1"}], ")"}]}]}], ",", 
                          " ", RowBox[{"1", "/", "5"}]}], "}"}]}]}], "]"}]}], 
                        "}"}]}]}], ",", " ", "\"Ellipse\"", ",", " ", 
                  RowBox[{RowBox[{"a", " ", "=", " ", RowBox[{"5", "/", 

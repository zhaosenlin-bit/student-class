Cell[CellGroupData[{

Cell["Definitions", "Subsection",ExpressionUUID->"bf1b48e5-bdbe-42eb-8294-c428c04259a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "=", 
   RowBox[{
    RowBox[{"y", "\[GreaterEqual]", "0"}], "&&", 
    RowBox[{
     RowBox[{"a", " ", "b"}], "\[GreaterEqual]", 
     RowBox[{
      RowBox[{"b", " ", "x"}], "+", 
      RowBox[{"a", " ", "y"}]}]}], "&&", 
    RowBox[{"x", "\[GreaterEqual]", "0"}]}]}], ";"}]], "Input",ExpressionUUID-\
>"338057ba-aa75-4a7a-a87d-02e8b0b06bbe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"implreg", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{"ineq", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}]], "Input",ExpressionUUI\
D->"a60fb496-fdf4-422f-8707-087064191849"],

Cell[BoxData[
 RowBox[{
  RowBox[{"verts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "b"}], "}"}]}], "}"}]}], ";"}]], "Input",ExpressionUUI\
D->"116abf45-27e2-430e-85f9-8a98e67b715b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"reg", "=", 
  RowBox[{"Triangle", "[", "verts", "]"}]}]], "Input",ExpressionUUID->\
"10ccf9fb-e0bc-4809-b3b7-0d8017ad905d"],

Cell[BoxData[
 RowBox[{"Triangle", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "b"}], "}"}]}], "}"}], "]"}]], "Output",ExpressionUUID-\
>"8b12a052-8acd-45e0-a613-575cdb49d0d5"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"assum", "=", 
   RowBox[{
    RowBox[{"a", ">", "0"}], "&&", 
    RowBox[{"b", ">", "0"}]}]}], ";"}]], "Input",ExpressionUUID->"85441ad6-\
dd7c-476d-b4c0-9a8109297365"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"t", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Triangle", "[", 
     RowBox[{"\[ScriptA]", ",", "\[ScriptB]", ",", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["\[ScriptA]", "2"], "+", 
        SuperscriptBox["\[ScriptB]", "2"]}], "]"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"\[ScriptA]", ">", "0"}], "&&", 
     RowBox[{"\[ScriptB]", ">", "0"}]}]}], "]"}]}]], "Input",ExpressionUUID->\
"cc4efaba-c4be-4775-a3d7-7928a088564d"],

Cell[BoxData[
 RowBox[{"Triangle", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox["\[ScriptA]", "2"], "+", 
        SuperscriptBox["\[ScriptB]", "2"]}]], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[ScriptB]", "2"], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[ScriptA]", "2"], "+", 
         SuperscriptBox["\[ScriptB]", "2"]}]]], ",", 
      FractionBox[
       RowBox[{"\[ScriptA]", " ", "\[ScriptB]"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[ScriptA]", "2"], "+", 
         SuperscriptBox["\[ScriptB]", "2"]}]]]}], "}"}]}], "}"}], 
  "]"}]], "Output",ExpressionUUID->"dd31fb3d-126f-4894-8e6e-75045cf56e5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"abc", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"SideLengths", "[", 
     RowBox[{"Evaluate", "[", "t", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"\[ScriptA]", ">", "0"}], "&&", 
     RowBox[{"\[ScriptB]", ">", "0"}]}]}], "]"}]}]], "Input",ExpressionUUID->\

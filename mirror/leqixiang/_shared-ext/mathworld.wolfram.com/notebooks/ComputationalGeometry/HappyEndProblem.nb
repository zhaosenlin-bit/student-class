Cell[BoxData[{
 RowBox[{"<<", "DiscreteMath`ComputationalGeometry`"}], "\n", 
 RowBox[{"<<", "DiscreteMath`Combinatorica`"}]}], "Input", \
ExpressionUUID->"157485f4-69fb-40e6-bd0c-3c79dd922ba3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ConvexNGon", "[", 
    RowBox[{"l_List", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"ConvexHull", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"KSubsets", "[", 
           RowBox[{"l", ",", "n"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], "\[Equal]", "n"}], "&"}], ",", 
         "1"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", "\[Equal]", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"s", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClosedLine", "[", "l_", "]"}], ":=", 
   RowBox[{"Line", "[", 
    RowBox[{"Append", "[", 
     RowBox[{"l", ",", 
      RowBox[{"First", "[", "l", "]"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"NGon", "[", 
   RowBox[{"l_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", "=", 
      RowBox[{"ConvexNGon", "[", 
       RowBox[{"l", ",", "n"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"c", "\[Equal]", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"ClosedLine", "[", "c", "]"}]}], "]"}]}], "\[IndentingNewLine]",
    "]"}]}]}], "Input", \
ExpressionUUID->"2810e912-92cd-4b17-821d-cf4e88af59f5"],


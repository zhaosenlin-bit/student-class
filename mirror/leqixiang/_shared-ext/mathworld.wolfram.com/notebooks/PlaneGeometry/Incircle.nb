Cell[CellGroupData[{

Cell["Angle Bisectors", "Section",ExpressionUUID->"e12a25d1-c3a0-4fb5-9bf8-8a23d6f4840e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tri", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1.3", ",", "1.7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3.", ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bis", "[", "i_", "]"}], ":=", 
   RowBox[{
    RowBox[{"AngleBisectors", "[", "tri", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vert", "[", "i_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Vertices", "[", "tri", "]"}], "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"perpfoot", "[", "i_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Perpendicular", "[", 
        RowBox[{
         RowBox[{"Coordinates", "@", 
          RowBox[{"Incenter", "[", "tri", "]"}]}], ",", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"Sides", "[", "tri", "]"}]}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Incenter", ",", "\"\<I\>\"", ",", "\[IndentingNewLine]", 
     RowBox[{"vert", "[", "1", "]"}], ",", "\"\<A\>\"", ",", 
     RowBox[{"vert", "[", "2", "]"}], ",", "\"\<B\>\"", ",", 
     RowBox[{"vert", "[", "3", "]"}], ",", "\"\<C\>\"", ","}], "\n", "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bluepts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bis", "[", "1", "]"}], ",", 
     "\"\<\!\(\*SubscriptBox[\(B\), \(A\)]\)\>\"", ",", 
     RowBox[{"bis", "[", "2", "]"}], ",", 
     "\"\<\!\(\*SubscriptBox[\(B\), \(B\)]\)\>\"", ",", 
     RowBox[{"bis", "[", "3", "]"}], ",", 
     "\"\<\!\(\*SubscriptBox[\(B\), \(C\)]\)\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"redpts", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"perpfoot", "[", "1", "]"}], ",", 
      "\"\<\!\(\*SubscriptBox[\(M\), \(A\)]\)\>\"", ",", 
      RowBox[{"perpfoot", "[", "2", "]"}], ",", 
      "\"\<\!\(\*SubscriptBox[\(M\), \(B\)]\)\>\"", ",", 
      RowBox[{"perpfoot", "[", "3", "]"}], ",", 
      "\"\<\!\(\*SubscriptBox[\(M\), \(C\)]\)\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "@", 
           RowBox[{"Perpendicular", "[", 
            RowBox[{
             RowBox[{"Coordinates", "@", 
              RowBox[{"Incenter", "[", "tri", "]"}]}], ",", "#"}], "]"}]}], 
          "&"}], "/@", 
         RowBox[{"Sides", "[", "tri", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"PerpSquare", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"Perpendicular", "[", 
               RowBox[{
                RowBox[{"Coordinates", "@", 
                 RowBox[{"Incenter", "[", "tri", "]"}]}], ",", "#"}], "]"}]}],
              "}"}], ",", ".1", ",", "3"}], "]"}], "&"}], "/@", 
         RowBox[{"Sides", "[", "tri", "]"}]}]}], "\[IndentingNewLine]", "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Incircle", "[", "tri", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Blue", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Coordinates", "@", 
              RowBox[{"Incenter", "[", "tri", "]"}]}], ",", "#"}], "}"}], 
           "]"}], "&"}], "/@", 
         RowBox[{"Vertices", "[", "tri", "]"}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"EqualAngleTicksAboutBisectors", "[", 
         RowBox[{"tri", ",", ".2", ",", ".05", ",", ".07"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"VertexArcs", "[", 
         RowBox[{"tri", ",", ".2"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
      ",", "\[IndentingNewLine]", "tri", ",", "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{"tri", ",", "pts"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointLabels", "[", 
         RowBox[{"tri", ",", "redpts"}], "]"}]}], "}"}]}], "\n", "  ", "}"}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",ExpressionUUID-\
>"00f1d700-4330-47bb-a5e2-9eb8d2782a57"],


                    RowBox[{
                    SuperscriptBox["b", "2"], "+", 
                    RowBox[{"9", " ", 
                    SuperscriptBox["r", "2"]}]}], ")"}]}]}], ")"}], 
                "2"]}]}]]}], ")"}], 

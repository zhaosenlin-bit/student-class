     RowBox[{"{", 
      RowBox[{"k", ",", "14"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rpoly", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"rotm", "[", 

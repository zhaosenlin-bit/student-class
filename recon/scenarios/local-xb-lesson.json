{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
  },
  "start_url": { "url": "http://localhost:4173/#play/mirror" },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 9000
    }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "url", "screenshot"],
    "events": ["console", "page-errors"],
    "limits": {
      "max_network_body_bytes": 4194304
    }
  }
}

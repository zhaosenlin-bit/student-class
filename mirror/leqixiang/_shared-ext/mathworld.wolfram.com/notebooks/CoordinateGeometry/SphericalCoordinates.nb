Cell[CellGroupData[{

Cell["Jacobian", "Section", ExpressionUUID->"5379f790-cd10-406d-9981-b2d2eed43c1f"],

Cell["\<\
The volume factor is the absolute value of the Cartesian Jacobian \
determinant. It is positive on the chart interior even though the order {r, \
theta, phi} reverses the standard spherical orientation.\
\>", "Text", ExpressionUUID->"15e7278b-82c9-4307-b084-b1bde5eebfad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoordinateChartData", "[", 
  RowBox[{"\"\<Spherical\>\"", ",", "\"\<VolumeFactor\>\"", ",", 
   "sphericalVars"}], "]"}]], "Input", \
ExpressionUUID->"d64787b8-15a7-4347-9e20-0b5722c4dd6e"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["r", "2"], " ", 
  RowBox[{"Sin", "[", "\[Phi]", "]"}]}]], "Output", \
ExpressionUUID->"e67ea2bc-2210-42bf-9036-02505fb6c635"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gradient", "Section", ExpressionUUID->"d370dab8-0fcf-4289-a466-af47bdef7fdb"],

Cell["\<\
Grad returns orthonormal spherical components in chart order. Reorder these \
to {r, theta, phi}, then take their dot product with unitvecs to express the \
gradient in Cartesian components.\
\>", "Text", ExpressionUUID->"83412030-dc66-4106-8d9e-ac6d3fa79584"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"f", "@@", "vars"}], ",", "sphericalVars", 
       ",", "\"\<Spherical\>\""}], "]"}], "\[LeftDoubleBracket]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], ".",
     "unitvecs"}], ",", "ranges"}], "]"}]], "Input", \
ExpressionUUID->"103a65bf-59fa-41ec-85d5-75ecf33064a7"],


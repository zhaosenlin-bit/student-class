{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:4174/#browse" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 3000 },
    {
      "step_id": "open-card",
      "action": "click",
      "locator": { "kind": "css", "selector": "text=长征 >> nth=0" },
      "timeout_ms": 15000
    },
    { "step_id": "after-open", "action": "wait_for_timeout", "duration_ms": 2500 }
  ],
  "capture": {
    "at_end": ["dom"]
  },
  "command_timeout_ms": 60000
}

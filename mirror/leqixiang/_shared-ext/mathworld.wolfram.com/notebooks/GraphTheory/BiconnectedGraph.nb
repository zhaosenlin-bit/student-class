Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TextGrid", "[", 
  RowBox[{
   RowBox[{"cnotb", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"Length", "[", "#", "]"}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
     RowBox[{"SplitBy", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphData", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<V\>\"", ",", "\"\<#\>\""}], "}"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"GraphData", "[", 
            RowBox[{"\"\<Connected\>\"", ",", 
             RowBox[{";;", "5"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"GraphData", "[", 
              RowBox[{"#", ",", "\"\<Biconnected\>\""}], "]"}]}], "&"}]}], 
          "]"}]}], "]"}], ",", "First"}], "]"}]}]}], ",", 
   RowBox[{"Dividers", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"07fdb71b-016a-44f7-b9b5-074842f77487"],


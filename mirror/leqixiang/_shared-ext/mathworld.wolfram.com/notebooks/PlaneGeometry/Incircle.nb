Cell["2 Equal Incircles, Solving for Lengths only", "Subsection",ExpressionUUID->"59590e7e-484a-46b8-8be7-5faee26070a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "+", "b", "+", "c"}], ")"}], "/", "2"}]}], "\n", 
 RowBox[{
  RowBox[{"d1", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"c", "^", "2"}], "+", 
     RowBox[{"b1", "^", "2"}], "-", 
     RowBox[{
      RowBox[{"b1", "/", "b"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", "^", "2"}], "+", 
        RowBox[{"c", "^", "2"}], "-", 
        RowBox[{"a", "^", "2"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "^", "2"}], "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"c", ",", "b1", ",", "d1"}], "]"}], "-", "c"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"c", ",", "b1", ",", "d1"}], "]"}], "-", "b1"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"c", ",", "b1", ",", "d1"}], "]"}], "-", "d1"}], ")"}], 
        "/", 
        RowBox[{"s", "[", 
         RowBox[{"c", ",", "b1", ",", "d1"}], "]"}]}]}]}], ",", "\n", "\t\t", 
     
     RowBox[{
      RowBox[{"r", "^", "2"}], "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"a", ",", 
           RowBox[{"b", "-", "b1"}], ",", "d1"}], "]"}], "-", "a"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"a", ",", 
           RowBox[{"b", "-", "b1"}], ",", "d1"}], "]"}], "-", 
         RowBox[{"(", 
          RowBox[{"b", "-", "b1"}], ")"}]}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"a", ",", 
            RowBox[{"b", "-", "b1"}], ",", "d1"}], "]"}], "-", "d1"}], ")"}], 
        "/", 
        RowBox[{"s", "[", 
         RowBox[{"a", ",", 
          RowBox[{"b", "-", "b1"}], ",", "d1"}], "]"}]}]}]}]}], "}"}], ",", 
   "\n", "\t", 
   RowBox[{"{", 
    RowBox[{"r", ",", "b1"}], "}"}]}], "]"}]}], "Input",ExpressionUUID->\
"6dff8866-918e-468c-ad0b-524f37764563"],


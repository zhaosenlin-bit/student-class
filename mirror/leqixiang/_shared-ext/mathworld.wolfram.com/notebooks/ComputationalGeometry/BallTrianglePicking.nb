          RowBox[{"4", "m"}], ")"}]}], "/", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"2", "m"}], ",", "m"}], "]"}]}], "/", 
       RowBox[{"Pi", "^", "2"}]}], " ", 
      RowBox[{"(", 

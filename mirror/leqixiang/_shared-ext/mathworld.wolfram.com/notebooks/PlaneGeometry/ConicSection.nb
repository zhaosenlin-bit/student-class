                      RowBox[{"3", "/", "2"}]}], ";", " ", RowBox[{"c", " ", 
                      "=", " ", "2"}], ";", " ", RowBox[{"p", " ", "=", " ", 
                      RowBox[{"{", RowBox[{RowBox[{"3", "/", "2"}], ",", " ", 
                          RowBox[{"6", "/", "5"}]}], "}"}]}], ";", " ", 
                    RowBox[{"curve", " ", "=", " ", RowBox[{"Circle", "[", 
                        RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", "0"}], 

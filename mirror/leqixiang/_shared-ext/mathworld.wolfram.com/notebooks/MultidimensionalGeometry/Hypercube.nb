Cell[CellGroupData[{

Cell["Points Maximizing Product of Distances to Vertices", "Section",ExpressionUUID->"eb4d224c-b50b-4baa-82f5-92b200d7adf8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MaximumProduct", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"List", ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}], ",", 
               RowBox[{"{", "n", "}"}]}], "]"}]}]}], "]"}], ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vars", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"x", ",", "n"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Maximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Times", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", ".", "#"}], "&"}], "[", 
              RowBox[{"vars", "-", "#"}], "]"}], "&"}], "/@", "v"}], ")"}]}], 
         ",", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "\[LessEqual]", "#", "\[LessEqual]", "1"}], "&"}], "/@",
             "vars"}], ")"}]}]}], "}"}], ",", "\[IndentingNewLine]", "vars"}],
       "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"NMaximumProduct", "[", 
   RowBox[{"n_", ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{"List", ",", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", "n", "}"}]}], "]"}]}]}], "]"}], ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"vars", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"x", ",", "n"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NMaximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Times", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", ".", "#"}], "&"}], "[", 
             RowBox[{"vars", "-", "#"}], "]"}], "&"}], "/@", "v"}], ")"}]}], 
        ",", 
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"0", "\[LessEqual]", "#", "\[LessEqual]", "1"}], "&"}], "/@",
            "vars"}], ")"}]}]}], "}"}], ",", "\[IndentingNewLine]", "vars", 
      ",", "\[IndentingNewLine]", "opts"}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"c67abcda-088e-49a4-8423-eb680a2dd61d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HypercubeProduct2", "[", "l_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "l", "]"}]}], ",", "v"}], "}"}], ",", 
    RowBox[{
     RowBox[{"v", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"List", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", "n", "}"}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Times", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ".", "#"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"l", "-", "#"}], "&"}], "/@", "v"}], ")"}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->"a63435cc-dd8d-\
4e23-a71b-5eab47073038"],


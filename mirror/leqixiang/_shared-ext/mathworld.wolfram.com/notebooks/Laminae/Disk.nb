 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox["x1", "2"], "+", 
    SuperscriptBox["y1", "2"]}], "\[LessEqual]", "1"}], "&&", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x2", "2"], "+", 
    SuperscriptBox["y2", "2"]}], "\[LessEqual]", "1"}]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Maximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x1", "-", "x2"}], ")"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y1", "-", "y2"}], ")"}], "^", "2"}]}], ",", "ineqs"}], 

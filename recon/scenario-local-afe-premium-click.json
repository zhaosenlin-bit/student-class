{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:4174/" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 4000 },
    {
      "step_id": "open-premium",
      "action": "click",
      "locator": { "kind": "css", "selector": "a.pc-nav-label[href=\"#premium\"]" },
      "timeout_ms": 15000
    },
    { "step_id": "after-premium", "action": "wait_for_timeout", "duration_ms": 4000 }
  ],
  "capture": {
    "at_end": ["url", "screenshot", "accessibility", "dom"],
    "events": ["console", "page-errors", "network"]
  },
  "command_timeout_ms": 90000
}

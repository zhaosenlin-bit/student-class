Cell[CellGroupData[{

Cell["Initialization", "Subsection",ExpressionUUID->"f8fd05e5-c074-4751-960a-14b3b16e574f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
     RowBox[{"r", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "z"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]", ",", "z"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ranges", "=", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "\[Theta]", "<", 
     RowBox[{"2", "\[Pi]"}]}], "&&", 
    RowBox[{"r", "\[GreaterEqual]", "0"}]}]}], ";"}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"691c452f-1452-45d1-9323-74c452ff4241"]
}, Open  ]],


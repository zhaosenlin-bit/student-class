Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CircularDistribution", "[", "num_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"Random", "[", "]"}], "]"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}], "//@", 
      RowBox[{"Random", "[", 
       RowBox[{"Real", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", "num", "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RadialDistribution", "[", "num_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Random", "[", "]"}], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}], "//@", 
     RowBox[{"Random", "[", 
      RowBox[{"Real", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", "num", "}"}]}], "]"}]}]}], "Input",
 InitializationCell->True]
}, Open  ]],


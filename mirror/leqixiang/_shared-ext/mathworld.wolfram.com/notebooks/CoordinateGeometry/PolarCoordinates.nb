  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"g", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "x_", "]"}], 
         "\[RuleDelayed]", 
         RowBox[{"Overscript", "[", 
          RowBox[{"x", ",", "\"\<.\>\""}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "2", "]"}], "[", "x_", "]"}], 
         "\[RuleDelayed]", 
         RowBox[{"Overscript", "[", 
          RowBox[{"x", ",", "\"\<..\>\""}], "]"}]}]}], "}"}]}], "/.", 
     RowBox[{
      RowBox[{"f_", "[", "t", "]"}], "\[RuleDelayed]", "f"}]}], ")"}], "//", 
   "TraditionalForm"}]}]], "Input"]

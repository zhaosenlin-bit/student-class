Cell[CellGroupData[{

Cell["Radius Vector", "Section"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r", "[", 
   RowBox[{"\[Lambda]_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"a", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "\[Lambda]", "]"}], 
      RowBox[{"Cos", "[", "\[Delta]", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Lambda]", "]"}], 
      RowBox[{"Cos", "[", "\[Delta]", "]"}]}], ",", 
     RowBox[{"Sin", "[", "\[Delta]", "]"}]}], "}"}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", ".", "#"}], "&"}], "@", 
     RowBox[{"r", "[", 
      RowBox[{"\[Lambda]", ",", "\[Delta]"}], "]"}]}], "]"}], ",", 
   RowBox[{"a", ">", "0"}]}], "]"}]], "Input"],

Cell[BoxData["a"], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Angular distance", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArcCos", "[", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "1"], ",", 
       SubscriptBox["\[Delta]", "1"]}], "]"}], ".", 
     RowBox[{"r", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "2"], ",", 
       SubscriptBox["\[Delta]", "2"]}], "]"}]}], "/", 
    RowBox[{"a", "^", "2"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"ArcCos", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", 
     SubscriptBox["\[Delta]", "1"], "]"}], " ", 
    RowBox[{"Cos", "[", 
     SubscriptBox["\[Delta]", "2"], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], "-", 
      SubscriptBox["\[Lambda]", "2"]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"Sin", "[", 
     SubscriptBox["\[Delta]", "1"], "]"}], " ", 
    RowBox[{"Sin", "[", 
     SubscriptBox["\[Delta]", "2"], "]"}]}]}], "]"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geodesic", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"r", "[", 
  RowBox[{"u", ",", 
   RowBox[{
    RowBox[{"Pi", "/", "2"}], "-", "v"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", " ", 
    RowBox[{"Cos", "[", "u", "]"}], " ", 
    RowBox[{"Sin", "[", "v", "]"}]}], ",", 
   RowBox[{"a", " ", 
    RowBox[{"Sin", "[", "u", "]"}], " ", 
    RowBox[{"Sin", "[", "v", "]"}]}], ",", 
   RowBox[{"a", " ", 
    RowBox[{"Cos", "[", "v", "]"}]}]}], "}"}]], "Output"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ds", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"u_", ",", "v_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "u"}], "]"}], "^", "2"}], ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "u"}], "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "v"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "v"}], "]"}], "^", "2"}]}], "}"}], "&"}], "/@", 
     "f"}], ")"}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"P", ",", "Q", ",", "R"}], "}"}], "=", 
  RowBox[{
   RowBox[{"Ds", "[", 
    RowBox[{
     RowBox[{"r", "[", 
      RowBox[{"u", ",", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], "-", "v"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}]}], "]"}], "//", "Simplify"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["a", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "v", "]"}], "2"]}], ",", "0", ",", 
   SuperscriptBox["a", "2"]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"i", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c1", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"R", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"P", "^", "2"}], "-", 
         RowBox[{
          RowBox[{"c1", "^", "2"}], " ", "P"}]}], ")"}]}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"c1", ">", "0"}], "&&", 
     RowBox[{"a", ">", "0"}], "&&", 
     RowBox[{"0", "<", "v", "<", "\[Pi]"}]}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"c1", " ", 
  RowBox[{"Csc", "[", "v", "]"}], " ", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["c1", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "v", "]"}], "2"]}]}]]]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["v4.x", "Subsubsection"],

Cell[TextData[{
 "Set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    RowBox[{"a", "/", 
     SubscriptBox["c", "1"]}]}], TraditionalForm]]],
 "to avoid Integrate giving a needlessly complicated answer"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"Sin", "[", "v", "]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"b", "^", "2"}], "  ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "v", "]"}], "2"]}], "-", " ", "1"}]]}]], ",", 
    "v"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"ArcTan", "[", 
   FractionBox[
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"Cos", "[", "v", "]"}]}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      SuperscriptBox["b", "2"], "-", 
      RowBox[{
       SuperscriptBox["b", "2"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "v"}], "]"}]}]}]]], "]"}]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"-", 
   RowBox[{"ArcTan", "[", 
    FractionBox[
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Cos", "[", "v", "]"}]}], 
     SqrtBox[
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        SuperscriptBox["b", "2"], "-", 
        RowBox[{
         SuperscriptBox["b", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "v", "]"}], "2"]}]}], ")"}]}]}], "]"}]]], 
    "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"ArcTan", "[", 
   FractionBox[
    RowBox[{"Cos", "[", "v", "]"}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       SuperscriptBox["b", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "v", "]"}], "2"]}]}]]], "]"}]}]], "Output"]
}, Open  ]],

Cell["Which can be rewritten as", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ArcTan", "[", 
     FractionBox[
      RowBox[{"Cos", "[", "v", "]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"poly", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{"\[Pi]", " ", "k"}], "7"], "]"}], ",", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{"\[Pi]", " ", "k"}], "7"], "]"}], ",", "0"}], "}"}], 
      RowBox[{"(", 

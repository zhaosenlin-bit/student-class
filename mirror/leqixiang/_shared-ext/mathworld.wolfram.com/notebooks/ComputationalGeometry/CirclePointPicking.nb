Cell[CellGroupData[{

Cell["Examples", "Section"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CirclePoints", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Random", "[", 
           RowBox[{"Real", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "n", "}"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ".", "#"}], "<=", "1"}], "&"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "^", "2"}], "-", 
           RowBox[{"#2", "^", "2"}]}], ")"}], ",", 
         RowBox[{"2", "#1", "#2"}]}], "}"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#1", "^", "2"}], "+", 
         RowBox[{"#2", "^", "2"}]}], ")"}]}], "&"}], "@@@", "pts"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"GraphicsArray", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", ".02", "]"}], ",", 
         RowBox[{"Point", "/@", 
          RowBox[{"CirclePoints", "[", "#", "]"}]}]}], "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], "&"}], "/@", 
    
    RowBox[{"{", 
     RowBox[{"50", ",", "100", ",", "500"}], "}"}]}], "]"}], "]"}]], "Input"],


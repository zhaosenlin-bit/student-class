{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://localhost:4174/#browse"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 3000
    },
    {
      "step_id": "open-card",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "text=诗贯山河 >> nth=0"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "wait-modal",
      "action": "wait_for_timeout",
      "duration_ms": 2000
    },
    {
      "step_id": "use",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button.detail-use-btn"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "after-use",
      "action": "wait_for_timeout",
      "duration_ms": 6000
    }
  ],
  "capture": {
    "at_end": [
      "url",
      "screenshot"
    ],
    "events": [
      "console",
      "page-errors",
      "network"
    ]
  },
  "command_timeout_ms": 60000
}
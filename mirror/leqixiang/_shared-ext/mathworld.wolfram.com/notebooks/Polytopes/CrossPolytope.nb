Cell["Vertices", "Section",ExpressionUUID->"a85b1d46-34e8-4eb8-a7fc-0f5c484a9b67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"section", " ", "13.4", " ", "of", " ", 
    RowBox[{"Coxeter", "'"}], "s", " ", "Regular", " ", "Polytopes"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CrossPolytopeCoordinates", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "r", ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Through", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Cos", ",", "Sin"}], "}"}], "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "r"}], "-", "1"}], ")"}], " ", "Pi", " ", 
               RowBox[{"k", "/", "n"}]}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{"Floor", "[", 
               RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"2", " ", "n"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OddQ", "[", "n", "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "k"}], "/", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"2", " ", "n"}]}], "}"}]}], "]"}], ",", "a"}], "]"}], 
       "/", 
       RowBox[{"Sqrt", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"ccda6bf6-4795-4042-af8c-f53622821602"],


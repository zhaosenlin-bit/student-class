         RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Altitudes", "[", "t", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\[IndentingNewLine]", 

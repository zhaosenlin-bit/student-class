                          " ", "b"}], "}"}]}], "]"}]}], ";", " ", RowBox[
                     {"foci", " ", "=", " ", RowBox[{"{", RowBox[{RowBox[
                          {"{", RowBox[{RowBox[{"-", "c"}], ",", " ", "0"}], 

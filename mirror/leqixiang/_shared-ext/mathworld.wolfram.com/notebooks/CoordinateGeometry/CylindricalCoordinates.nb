    RowBox[{"-", "\[Theta]hat"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}], "\[Rule]", 
    RowBox[{"-", "zhat"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", "zero"}]}], 
  "}"}]], "Output",ExpressionUUID->"1f2bd2c3-1737-4651-9707-2f7c12e18ab6"]

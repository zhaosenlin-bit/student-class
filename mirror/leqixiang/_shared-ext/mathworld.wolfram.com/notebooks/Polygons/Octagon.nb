Cell[CellGroupData[{

Cell["Examples", "Section",ExpressionUUID->"28022845-6505-4576-8565-22f137dca84b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"laminae", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"EntityList", "[", 
     RowBox[{"EntityClass", "[", 
      RowBox[{"\"\<Lamina\>\"", ",", "\"\<Polygon\>\""}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<VertexCount\>\"", "]"}], "\[Equal]", "8"}], 
     "&"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"05bb8aa6-2e15-4314-ab88-f4810dce23bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"\"regular octagon\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"FilledRegularOctagon\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"FilledRegularOctagon\\\"]\"","\"lamina\""},
    
    "Entity"], ",", 
   TemplateBox[{"\"inverted T\[Hyphen]beam\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"InvertedTBeam\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"InvertedTBeam\\\"]\"","\"lamina\""},
    "Entity"], ",", 
   TemplateBox[{"\"square channel\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"SquareChannel\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"SquareChannel\\\"]\"","\"lamina\""},
    "Entity"], ",", 
   TemplateBox[{"\"square T\[Hyphen]beam\"",RowBox[{"Entity", "[", 
       RowBox[{"\"Lamina\"", ",", "\"SquareTBeam\""}], "]"}],
     "\"Entity[\\\"Lamina\\\", \\\"SquareTBeam\\\"]\"","\"lamina\""},
    "Entity"]}], "}"}]], "Output",
 CellLabel->
  "Out[155]=",ExpressionUUID->"e2236b70-7c3b-4285-aab8-84f05830fec5"]
}, Open  ]],

Cell[CellGroupData[{


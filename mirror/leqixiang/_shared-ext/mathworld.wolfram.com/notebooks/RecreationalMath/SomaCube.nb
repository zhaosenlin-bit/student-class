Cell[BoxData[{
 RowBox[{
  RowBox[{"partition", "[", 
   RowBox[{"l_List", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Length", "[", "l", "]"}], ",", "n"}], "]"}]}], ",", "p"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"l", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "\[Equal]", "0"}], ",", "p", ",", 
       RowBox[{"Append", "[", 
        RowBox[{"p", ",", 
         RowBox[{"Take", "[", 
          RowBox[{"l", ",", 
           RowBox[{"-", "m"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"GraphicsArray", "[", 
    RowBox[{"partition", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{"Soma", "[", "i", "]"}], "]"}], ",", 
          RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
          RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
          RowBox[{"DisplayFunction", "\[Rule]", "Identity"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "7"}], "}"}]}], "]"}], ",", "4"}], "]"}], "]"}], 
   ",", 
   RowBox[{"DisplayFunction", "\[Rule]", "$DisplayFunction"}]}], 
  "]"}]}], "Input"],


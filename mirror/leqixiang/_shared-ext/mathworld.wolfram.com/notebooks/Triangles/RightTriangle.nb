               RowBox[{"Midpoints", "[", "t", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              "\"\<\!\(\*SubscriptBox[\(M\), \(A\)]\)\>\"", ",", " ", 
              "Green"}], "}"}], ",", "\[IndentingNewLine]", 

Cell["Initialization", "Subsection"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "Graphics`Shapes`"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"<<", "Graphics`Graphics`"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"SpherePlot", "[", 
   RowBox[{"pts_", ",", "vp_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"GraphicsArray", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"PointSize", "[", ".03", "]"}], ",", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"EdgeForm", "[", 
              RowBox[{"RGBColor", "[", 
               RowBox[{".5", ",", "0", ",", "0"}], "]"}], "]"}], ",", 
             RowBox[{"FaceForm", "[", 
              RowBox[{
               RowBox[{"GrayLevel", "[", "1", "]"}], ",", 
               RowBox[{"GrayLevel", "[", "1", "]"}]}], "]"}], ",", 
             RowBox[{"Sphere", "[", ".99", "]"}]}], "}"}], ",", 
           RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
           RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
           RowBox[{"Lighting", "\[Rule]", "False"}], ",", 
           RowBox[{"ViewPoint", "\[Rule]", 
            RowBox[{"vp", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
       "]"}], ",", 
      RowBox[{"GraphicsSpacing", "\[Rule]", 
       RowBox[{"-", ".2"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Comparing Uniform and Nonuniform", "Section"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SphericalNonUniformDistribution", "[", "num_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "#1", "]"}], 
          RowBox[{"Sin", "[", "#2", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "#1", "]"}], 
          RowBox[{"Sin", "[", "#2", "]"}]}], ",", 
         RowBox[{"Cos", "[", "#2", "]"}]}], "}"}], "&"}], "[", 
      RowBox[{
       RowBox[{"Random", "[", 
        RowBox[{"Real", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Random", "[", 
        RowBox[{"Real", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Pi"}], "}"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", "num", "}"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"SphericalDistribution", "[", "num_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "#1", "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "#1", "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"#2", "^", "2"}]}], "]"}]}], ",", "#2"}], "}"}], "&"}], 
     "[", 
     RowBox[{
      RowBox[{"Random", "[", 
       RowBox[{"Real", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Random", "[", 
       RowBox[{"Real", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", "num", "}"}]}], "]"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PointSize", "[", ".01", "]"}], ",", 
     RowBox[{"Point", "/@", 
      RowBox[{"SphericalNonUniformDistribution", "[", "10000", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeForm", "[", 
        RowBox[{"RGBColor", "[", 
         RowBox[{".5", ",", "0", ",", "0"}], "]"}], "]"}], ",", 
       RowBox[{"FaceForm", "[", 
        RowBox[{
         RowBox[{"GrayLevel", "[", "1", "]"}], ",", 
         RowBox[{"GrayLevel", "[", "1", "]"}]}], "]"}], ",", 
       RowBox[{"Sphere", "[", ".99", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input"],


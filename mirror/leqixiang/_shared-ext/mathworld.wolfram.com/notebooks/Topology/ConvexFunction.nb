Cell[CellGroupData[{

Cell["Code", "Subsection"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvexQ", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"reg_:", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "\[Lambda]"}], "}"}], ",", 
    RowBox[{"Resolve", "[", 
     RowBox[{
      RowBox[{"ForAll", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2", ",", "\[Lambda]"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"0", "<", "\[Lambda]", "<", "1"}], "&&", 
         RowBox[{
          RowBox[{"reg", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "x1", "<", 
          RowBox[{"reg", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{"reg", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "x2", "<", 
          RowBox[{"reg", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"\[Lambda]", " ", "x1"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Lambda]"}], ")"}], "x2"}]}], "]"}], 
         "\[LessEqual]", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"f", "[", "x1", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Lambda]"}], ")"}], 
           RowBox[{"f", "[", "x2", "]"}]}]}]}]}], "\[IndentingNewLine]", 
       "]"}], ",", "Reals"}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "Section"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["x", "p"], TraditionalForm]]]], "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"ConvexQ", "[", 
     RowBox[{
      RowBox[{"#", "^", "n"}], "&"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "6"}], "}"}]}], "]"}], "//", "Timing"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1.979705`", " ", "Second"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "True", ",", "True", ",", "False", ",", "True", ",", "False", ",", 
     "True"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{"x", " ", 
   RowBox[{"log", "(", "x", ")"}]}], TraditionalForm]], "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConvexQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", " ", 
     RowBox[{"Log", "[", "#", "]"}]}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[ForAll]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1$95", ",", "x2$95", ",", "\[Lambda]$95"}], "}"}], ",", 
    RowBox[{
     RowBox[{"0", "<", "\[Lambda]$95", "<", "1"}], "&&", 
     RowBox[{"0", "<", "x1$95", "<", "\[Infinity]"}], "&&", 
     RowBox[{"0", "<", "x2$95", "<", "\[Infinity]"}]}]}]], 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x2$95", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Lambda]$95"}], ")"}]}], "+", 
      RowBox[{"x1$95", " ", "\[Lambda]$95"}]}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"x2$95", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Lambda]$95"}], ")"}]}], "+", 
      RowBox[{"x1$95", " ", "\[Lambda]$95"}]}], "]"}]}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"x1$95", " ", "\[Lambda]$95", " ", 
     RowBox[{"Log", "[", "x1$95", "]"}]}], "+", 
    RowBox[{"x2$95", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Lambda]$95"}], ")"}], " ", 
     RowBox[{"Log", "[", "x2$95", "]"}]}]}]}]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConvexQ", "[", 
  RowBox[{
   RowBox[{"Abs", "[", "#", "]"}], "&"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]]

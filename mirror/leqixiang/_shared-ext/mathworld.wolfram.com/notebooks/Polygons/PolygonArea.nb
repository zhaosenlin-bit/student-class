       RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"q", "=", 
          RowBox[{"Quadrilateral", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Random", "[", "]"}], ",", 
             RowBox[{"{", "4", "}"}], ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 

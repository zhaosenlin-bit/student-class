     "\[Placeholder]"},
    {"\"\<OctahedralGraph\>\"", "0", "1", "\[Placeholder]", "\[Placeholder]", 
     "\[Placeholder]", "\[Placeholder]"},
    {"\"\<TetrahedralGraph\>\"", "0", "0", "0", "2", "\[Placeholder]", 
     "\[Placeholder]"}
   },

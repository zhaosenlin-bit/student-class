{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
  },
  "start_url": { "url": "https://aifunengjiaoyu.com/" },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 6000
    }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "url", "screenshot"],
    "events": ["network", "console", "page-errors"],
    "network": {
      "response_body": true,
      "header_values": true
    },
    "limits": {
      "max_network_body_bytes": 4194304,
      "max_network_body_allocation_bytes": 8388608
    }
  }
}

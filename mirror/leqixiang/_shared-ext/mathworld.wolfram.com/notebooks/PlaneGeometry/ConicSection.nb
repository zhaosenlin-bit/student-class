Cell[CellGroupData[{

Cell["Conic-conic intersection", "Section", ExpressionUUID->"a85c12d0-bf15-45a6-bda2-87eab13e9856"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a1", " ", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"2", "b1", " ", "x", " ", "y"}], "+", 
        RowBox[{"c1", " ", 
         RowBox[{"y", "^", "2"}]}], "+", 
        RowBox[{"2", "d1", " ", "x"}], "+", 
        RowBox[{"2", "f1", " ", "y"}], "+", "g1"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"a2", " ", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"2", "b2", " ", "x", " ", "y"}], "+", 
        RowBox[{"c2", " ", 
         RowBox[{"y", "^", "2"}]}], "+", 
        RowBox[{"2", "d2", " ", "x"}], "+", 
        RowBox[{"2", "f2", " ", "y"}], "+", "g2"}], "\[Equal]", "0"}]}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "//", "Timing"}]], "Input", \
ExpressionUUID->"147b7177-eb10-452d-a877-58f660182571"],

Cell[BoxData["$Aborted"], "Output", ExpressionUUID->"df8de77d-a813-40a5-af23-82fc8d128c94"]

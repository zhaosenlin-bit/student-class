Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b_", ",", "c_", ",", "d_", ",", "f_", ",", "g_"}], "}"}]}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"2", "b", " ", "x", " ", "y"}], "+", 
     RowBox[{"c", " ", 
      RowBox[{"y", "^", "2"}]}], "+", 
     RowBox[{"d", " ", "x"}], " ", "+", 
     RowBox[{"f", " ", "y"}], "+", "g"}], "\[Equal]", "0"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conic", "[", 
    RowBox[{"pts_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"coniccoefs", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"coniccoefs", "[", 
   RowBox[{"pts_", ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", ",", "c", ",", "d", ",", "f", ",", "g"}], "}"}], "/.", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "c", ",", "d", ",", "f", ",", "g"}], "}"}]}], 
         "]"}], "&"}], "/@", "pts"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g"}], 
       "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]}], "Input", \

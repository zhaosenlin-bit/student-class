Cell[BoxData[{
 RowBox[{
  RowBox[{"CircumcircleDiagram", "[", "v_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tri", "=", 
      RowBox[{"Triangle", "[", "v", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ClosedLine", "[", "v", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"EqualSideTicksAboutMidpoints", "[", 
       RowBox[{"tri", ",", ".05"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Circumcircle", "[", "tri", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Red", ",", "\[IndentingNewLine]", 
        RowBox[{"PerpendicularBisectors", "[", "tri", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PointLabels", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<M\>\"", ",", "#"}], "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
              "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], "&"}], "/@", 
             RowBox[{"PerpendicularBisectors", "[", "tri", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LabelOffset", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{".16", ",", ".14"}], "}"}]}], ",", 
              RowBox[{"LabelOffset", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", ".14"}], ",", ".12"}], "}"}]}], ",", 
              RowBox[{"LabelOffset", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{".02", ",", 
                 RowBox[{"-", ".16"}]}], "}"}]}]}], "}"}]}], 
           "\[IndentingNewLine]", "}"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"PerpSquare", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"PerpendicularLine", "[", 
               RowBox[{
                RowBox[{"Circumcenter", "[", "tri", "]"}], ",", "#"}], 
               "]"}]}], "}"}], ",", ".08", ",", "2"}], "]"}], "&"}], "/@", 
         RowBox[{"Sides", "[", "tri", "]"}]}]}], "\[IndentingNewLine]", "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Green", ",", "\[IndentingNewLine]", 
        RowBox[{"Line", "[", 
         RowBox[{"Coordinates", "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TarryPoint", "[", "tri", "]"}], ",", 
            RowBox[{"SteinerPoint", "[", "tri", "]"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PointLabels", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<T\>\"", ",", 
             RowBox[{
              RowBox[{"TarryPoint", "[", "tri", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"LabelOffset", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", ".1"}], ",", 
                RowBox[{"-", ".13"}]}], "}"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<S\>\"", ",", 
             RowBox[{
              RowBox[{"SteinerPoint", "[", "tri", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"LabelOffset", "\[Rule]", ".12"}]}], "}"}]}], "}"}], 
         "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Coordinates", "@", 
              RowBox[{"Circumcenter", "[", "tri", "]"}]}], ",", "#"}], "}"}], 
           "]"}], "&"}], "/@", 
         RowBox[{"Vertices", "[", "tri", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointLabels", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\"", ",", 
            "\"\<O\>\""}], "}"}], ",", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"Vertices", "[", "tri", "]"}], ",", 
            RowBox[{
             RowBox[{"Circumcenter", "[", "tri", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"LabelOffset", "\[Rule]", 
             RowBox[{"-", ".12"}]}], ",", 
            RowBox[{"LabelOffset", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{".12", ",", 
               RowBox[{"-", ".12"}]}], "}"}]}], ",", 
            RowBox[{"LabelOffset", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"0", ",", ".14"}], "}"}]}], ",", 
            RowBox[{"LabelOffset", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{".1", ",", 
               RowBox[{"-", ".14"}]}], "}"}]}]}], "}"}]}], "}"}], "]"}], 
       "]"}]}], "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{"MyPointLabels", "/@", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Circumcenter", "[", "tri", "]"}], ",", "\"\<O\>\""}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexPoints", "[", "tri", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
              "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
      "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", "}"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\n", 
 RowBox[{"Graphics", "[", 
  RowBox[{"CircumcircleDiagram", "[", 
   RowBox[{"{", 
    RowBox[{

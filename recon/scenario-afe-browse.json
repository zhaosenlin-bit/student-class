{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:4174/" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 3000 },
    {
      "step_id": "browse",
      "action": "click",
      "locator": { "kind": "css", "selector": "a[href=\"#browse\"] >> nth=0" },
      "timeout_ms": 15000
    },
    { "step_id": "after-browse", "action": "wait_for_timeout", "duration_ms": 3000 }
  ],
  "capture": {
    "at_end": ["url", "screenshot", "accessibility"],
    "events": ["console", "page-errors", "network"]
  },
  "command_timeout_ms": 60000
}

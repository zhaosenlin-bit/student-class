Cell[CellGroupData[{

Cell["Deifnitions", "Subsection",ExpressionUUID->"36ad559e-e9df-4af1-a2e6-19f85b963935"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ineq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], "/", "2"}], "\[LessEqual]", "x", "\[LessEqual]", 
     RowBox[{"a", "/", "2"}]}], "&&", 
    RowBox[{"0", "\[LessEqual]", "y", "\[LessEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Abs", "[", 
         RowBox[{"x", "/", 
          RowBox[{"(", 
           RowBox[{"a", "/", "2"}], ")"}]}], "]"}]}], ")"}], " ", "a", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"5", "+", 
         RowBox[{"2", 
          RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}], "/", "2"}]}]}]}]}], 
  ";"}]], "Input",ExpressionUUID->"2cf81c9b-a45f-43b0-a5e0-698eb26e933c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"implreg", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{"ineq", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}]], "Input",ExpressionUUI\
D->"4cbc3b35-cd81-4f1c-9ea1-facadb5aee38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"Triangle", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], "/", "2"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "/", "2"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"5", "+", 
            RowBox[{"2", 
             RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}], "/", "2"}], " ", 
         "a"}]}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"c8b40739-03c5-463d-84b9-6c40b87e1fb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assum", "=", 
   RowBox[{"a", ">", "0"}]}], ";"}]], "Input",ExpressionUUID->"24200a03-ab3c-\
4e8f-900e-8434880697fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure", "Section",ExpressionUUID->"35bd1f60-27d1-459b-a809-2a6d80129055"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "GoldenRatio"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"a", "^", "2"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "/", "2"}], ")"}], "^", "2"}]}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"357f893e-b0f5-44a0-a79f-23dc404ee948"],

Cell[CellGroupData[{

Cell[BoxData[

Cell[CellGroupData[{

Cell["Using at most colors with no restrictions on adjacenct faces", "Section",
 CellChangeTimes->{{3.652008971697384*^9, 3.6520089850298767`*^9}, 
   3.6520090209805937`*^9}],

Cell["\<\
Oyvind Tafjord
October 6, 2004\
\>", "Text",
 CellChangeTimes->{3.652009327344481*^9}],

Cell[CellGroupData[{

Cell["Discussion", "Subsubsection"],

Cell[TextData[{
 "To find the number of colorings of a polyhedron, you need to derive the \
symmetry group for the faces of the solid and then feed this to ",
 StyleBox["Polya",
  FontFamily->"Courier"],
 "[group, n]. Here's a (possibly inefficient) way of doing it, starting from \
the faces, deriving the corresponding graph, using ",
 StyleBox["Automorphisms",
  FontFamily->"Courier"],
 " to find all the symmetries (this takes a while), removing the symmetries \
that invert a face (we only want rotations, not inversions), then finding the \
induced symmetry group for the faces. There are surely much more \
straightforward ways of constructing this directly from other groups, but \
this should work any object for which the face information is known."
}], "Text"],

Cell[TextData[{
 "Note that ",
 StyleBox["PolyhedronFaces",
  FontFamily->"Courier"],
 "[solid] is the same as ",
 StyleBox["ToAdjacencyLists",
  FontFamily->"Courier"],
 "[dual graph]"
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code", "Subsubsection",
 CellChangeTimes->{{3.652009003046467*^9, 3.652009003444757*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cycleit", "[", "l_", "]"}], ":=", 
  RowBox[{"RotateLeft", "[", 
   RowBox[{"l", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Ordering", "[", "l", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"PolyhedronColoring", "[", 
   RowBox[{"solid_", ",", "cols_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "GroupIh", ",", "GroupI", ",", "GroupFaces"}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"cycleit", "/@", 
       RowBox[{"PolyhedronData", "[", 
        RowBox[{"solid", ",", "\"\<FaceIndices\>\""}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GroupIh", "=", 
      RowBox[{"Automorphisms", "[", 
       RowBox[{"FromUnorderedPairs", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"Sort", "/@", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Partition", "[", 
               RowBox[{"#", ",", "2", ",", "1", ",", "1"}], "]"}], "&"}], "/@",
              "f"}], ",", "1"}], "]"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GroupI", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"GroupIh", ",", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"f", ",", 
           RowBox[{"cycleit", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"f", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], 
         "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GroupFaces", "=", 
      RowBox[{"KSubsetGroup", "[", 
       RowBox[{"GroupI", ",", 
        RowBox[{"Sort", "/@", "f"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Polya", "[", 
      RowBox[{"GroupFaces", ",", "cols"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True]
}, Open  ]],


k\" data-error-text=\"Failed to load title\" data-id=\"408494038\" data-permission-text=\"Title is private\" data-url=\"https://github.com/mrdoob/three.js/issues/15749\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/mrdoob/three.js/pull/15749/hovercard\" href=\"https://github.com/mrdoob/three.js/pull/15749\"\u003e#15749\u003c/a\u003e — the regression is intentional, and can be avoided by including tangents in the model.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eIdeally we would have a JS implementation for generating mikktspace tangents, to fully solve this, but that is fairly complex.\u003c/p\u003e","bodyVersion":"5fcb1d643440c01babd39bd6ea78fb75c1aa9c58788d69ecf0f90223cbfe05d0","viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzYyMDE=","name":"three.js","owner":{"__typename":"User","id":"MDQ6VXNlcjk3MDg4","login":"mrdoob","url":"https://github.com/mrdoob"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"mrdoob/three.js","databaseId":576201},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":1,"nodes":[{"__typename":"User","id":"MDQ6VXNlcjk3MDg4","login":"mrdoob","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/97088?s=64\u0026u=95046da3776175b5f3d1ad2137704cd123e04d9e\u0026v=4"}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}]}},{"cursor":"Y3Vyc29yOnYyOpPPAAABa07BtLABqjI0MDkyMjkwMTg=","node":{"_
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cos", "[", "\[Alpha]", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", "2"}], "+", 
      RowBox[{"c", "^", "2"}], "-", 
      RowBox[{"a", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "b", " ", "c"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cos", "[", "\[Beta]", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"b", "^", "2"}]}], "+", 
      RowBox[{"c", "^", "2"}], "+", 
      RowBox[{"a", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "c", " ", "a"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cos", "[", "\[Gamma]", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"c", "^", "2"}]}], "+", 
      RowBox[{"a", "^", "2"}], "+", 
      RowBox[{"b", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "a", " ", "b"}], ")"}]}]}], ";"}]}], "Input", \
ExpressionUUID->"8b702eaa-dcee-4aff-9bd1-cd1b8f47bd8a"],

